\set ON_ERROR_STOP on
-- Disposable localhost PostgreSQL ONLY: no connection to live Supabase.
DO $roles$
DECLARE label text;
BEGIN
 FOREACH label IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=label) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',label);
  END IF;
 END LOOP;
END
$roles$;
CREATE SCHEMA IF NOT EXISTS auth;
CREATE TABLE IF NOT EXISTS auth.users(id uuid PRIMARY KEY);
CREATE SCHEMA IF NOT EXISTS private;
CREATE TABLE private.iclub_ai_paid_canary_control_v1(
 singleton smallint PRIMARY KEY,enabled boolean NOT NULL DEFAULT false
);
INSERT INTO private.iclub_ai_paid_canary_control_v1 VALUES(1,false);
\ir iclub_ai_qa_global_operator_v1_UNAPPLIED.sql
BEGIN;
DO $cases$
DECLARE id uuid:='11111111-1111-4111-8111-111111111111';r jsonb;
BEGIN
 IF has_function_privilege('anon',
  'public.authorize_iclub_ai_qa_global_operator_v1(uuid)','EXECUTE')
 OR has_function_privilege('authenticated',
  'public.authorize_iclub_ai_qa_global_operator_v1(uuid)','EXECUTE')
 OR has_table_privilege('service_role',
  'private.iclub_ai_qa_global_operator_v1','INSERT') THEN
  RAISE EXCEPTION 'operator privileges too open';
 END IF;
 r:=public.authorize_iclub_ai_qa_global_operator_v1(id);
 IF r->>'reason'<>'operator_only' THEN
  RAISE EXCEPTION 'anonymous operator passed %',r;
 END IF;
 PERFORM set_config('request.jwt.claim.role','service_role',true);
 r:=public.authorize_iclub_ai_qa_global_operator_v1(id);
 IF r->>'reason'<>'operator_not_enrolled' THEN
  RAISE EXCEPTION 'unenrolled operator passed %',r;
 END IF;
 INSERT INTO auth.users VALUES(id);
 INSERT INTO private.iclub_ai_qa_global_operator_v1(user_id,enabled)
 VALUES(id,false);
 r:=public.authorize_iclub_ai_qa_global_operator_v1(id);
 IF r->>'allowed'='true' THEN RAISE EXCEPTION 'disabled operator passed';END IF;
 UPDATE private.iclub_ai_qa_global_operator_v1 SET enabled=true WHERE user_id=id;
 r:=public.authorize_iclub_ai_qa_global_operator_v1(id);
 IF r->>'allowed'<>'true' OR r->>'money_enabled'<>'false' THEN
  RAISE EXCEPTION 'enabled operator failed closed-money stage %',r;
 END IF;
 UPDATE private.iclub_ai_paid_canary_control_v1 SET enabled=true WHERE singleton=1;
 r:=public.authorize_iclub_ai_qa_global_operator_v1(id);
 IF r->>'allowed'<>'true' OR r->>'money_enabled'<>'true' THEN
  RAISE EXCEPTION 'enabled operator missed independent money flag %',r;
 END IF;
 UPDATE private.iclub_ai_qa_global_operator_v1 SET enabled=false WHERE user_id=id;
 r:=public.authorize_iclub_ai_qa_global_operator_v1(id);
 IF r->>'allowed'='true' THEN RAISE EXCEPTION 'revoked operator passed';END IF;
 RAISE NOTICE 'QA GLOBAL APP AUTH PASS: service role only, empty default, opt-in, DB kill switch, revoke';
END
$cases$;
ROLLBACK;
