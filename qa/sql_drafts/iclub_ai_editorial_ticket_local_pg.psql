 ('11111111-1111-4111-8111-111111111111',11),
 ('11111111-1111-4111-8111-111111111111',12),
 ('11111111-1111-4111-8111-111111111111',13);
INSERT INTO public.practice_sessions_v4 VALUES
 (900,'11111111-1111-4111-8111-111111111111',10,'finalized',now(),ARRAY[901,902]),
 (910,'11111111-1111-4111-8111-111111111111',12,'finalized',now(),ARRAY[911]),
 (920,'11111111-1111-4111-8111-111111111111',11,'in_progress',NULL,ARRAY[921]),
 (930,'11111111-1111-4111-8111-111111111111',13,'finalized',now(),ARRAY[931]);
INSERT INTO public.practice_session_answers_v4 VALUES
 (900,901),(910,911),(920,921),(930,931);


\ir iclub_ai_topic_release_gate_v21_UNAPPLIED.sql
\ir iclub_ai_source_proof_bundle_v21_UNAPPLIED.sql
UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=false,ui_enabled=true,gateway_enabled=true;

\ir iclub_ai_editorial_ticket_publisher_v21_UNAPPLIED.sql
-- Synthetic release INSERT error fires AFTER the editorial source UPDATE
-- inside the same publish function. Catch outside to assert full rollback.
CREATE FUNCTION private.synthetic_editorial_publication_failure()
 RETURNS trigger LANGUAGE plpgsql AS $synthetic_failure$
BEGIN
 RAISE EXCEPTION 'synthetic_editorial_publication_failure';
END;
$synthetic_failure$;
CREATE TRIGGER synthetic_editorial_publish_fail
 BEFORE INSERT ON private.iclub_ai_topic_release_v21
 FOR EACH ROW EXECUTE FUNCTION private.synthetic_editorial_publication_failure();
DO $ticket_test$
DECLARE
 learner uuid:='11111111-1111-4111-8111-111111111111';
 reviewer_content uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 reviewer_rights uuid:='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
 reviewer_technical uuid:='cccccccc-cccc-4ccc-8ccc-cccccccccccc';
 reviewer_safety uuid:='dddddddd-dddd-4ddd-8ddd-dddddddddddd';
 pub_ticket uuid:='11111111-aaaa-4aaa-8aaa-111111111111';
 revoke_ticket uuid:='22222222-bbbb-4bbb-8bbb-222222222222';
 second_ticket uuid:='33333333-cccc-4ccc-8ccc-333333333333';
 source_body text:='Synthetic technical payload, NOT an approved educational lesson.';
 prepared jsonb:='{"topic_main":"Synthetic prepared result, not academic content."}'::jsonb;
 h text;digest text;
 ret jsonb;missing_evidence jsonb;injected_failure boolean;
BEGIN
 -- Publication executor role intentionally has NO session/academic privileges.
 IF has_function_privilege('service_role',
  'public.publish_iclub_ai_v21_ticket(uuid,bigint)','EXECUTE')
 OR has_function_privilege('authenticated',
  'public.revoke_iclub_ai_v21_ticket(uuid,bigint)','EXECUTE')
 OR NOT has_function_privilege('iclub_ai_v21_editorial_publisher',
  'public.publish_iclub_ai_v21_ticket(uuid,bigint)','EXECUTE') THEN
  RAISE EXCEPTION 'Unsafe publication EXECUTE GRANT detected';
 END IF;
 digest:=encode(sha256(convert_to(source_body||E'\n'||prepared::text,'UTF8')),'hex');
 INSERT INTO private.iclub_ai_v21_editorial_source_versions(
 surface_code,subject_key,feature_code,topic_key,locale,
 source_id,source_version,source_hash,source_text,prepared_variants)
 VALUES('lesson','biology','topic_explanation','lesson_101','ru',
 'synthetic-review-01','v1',digest,source_body,prepared);
 -- Merely receiving content cannot enable a topic.
 ret:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF ret->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Draft content became published without approval: %',ret;END IF;
 missing_evidence:='{"content_approved":true,"rights_approved":true,
 "source_version_verified":true,"correctness_passed":true,
 "negative_tests_passed":true,"exam_security_passed":true,
 "locale_verified":true,"accessibility_passed":false}'::jsonb;
 INSERT INTO private.iclub_ai_v21_editorial_tickets(
 ticket_id,surface_code,subject_key,feature_code,topic_key,locale,
 source_id,source_version,source_hash,action,qa_evidence)
 VALUES(pub_ticket,'lesson','biology','topic_explanation','lesson_101','ru',
 'synthetic-review-01','v1',digest,'publish',missing_evidence);
 ret:=public.publish_iclub_ai_v21_ticket(pub_ticket,0);
 IF ret->>'reason' IS DISTINCT FROM 'editorial_signoffs_missing' THEN
  RAISE EXCEPTION 'Unsigned editorial ticket was accepted: %',ret;END IF;
 INSERT INTO private.iclub_ai_v21_ticket_signoffs(ticket_id,reviewer_id,review_domain)
 VALUES(pub_ticket,reviewer_content,'content'),
 (pub_ticket,reviewer_rights,'rights'),
 (pub_ticket,reviewer_technical,'technical');
 ret:=public.publish_iclub_ai_v21_ticket(pub_ticket,0);
 IF ret->>'reason' IS DISTINCT FROM 'editorial_gate_missing' THEN
  RAISE EXCEPTION 'Insufficient editorial evidence got published: %',ret;END IF;
 UPDATE private.iclub_ai_v21_editorial_tickets
 SET qa_evidence=jsonb_set(qa_evidence,'{accessibility_passed}','true'::jsonb)
 WHERE ticket_id=pub_ticket;
 ret:=public.publish_iclub_ai_v21_ticket(pub_ticket,5);
 IF ret->>'reason' IS DISTINCT FROM 'revision_or_state_conflict' THEN
  RAISE EXCEPTION 'Wrong initial revision published: %',ret;END IF;
 -- Deliberately interrupt the atomic operation after source status UPDATE.
 injected_failure:=false;
 BEGIN
  ret:=public.publish_iclub_ai_v21_ticket(pub_ticket,0);
 EXCEPTION WHEN OTHERS THEN
  IF SQLERRM NOT LIKE '%synthetic_editorial_publication_failure%' THEN
   RAISE;
  END IF;
  injected_failure:=true;
 END;
 IF NOT injected_failure THEN
  RAISE EXCEPTION 'Synthetic publication failure did not execute';END IF;
 IF EXISTS(SELECT 1 FROM private.iclub_ai_topic_release_v21
  WHERE subject_key='biology' AND topic_key='lesson_101')
 OR NOT EXISTS(SELECT 1 FROM private.iclub_ai_v21_editorial_source_versions
  WHERE subject_key='biology' AND source_id='synthetic-review-01'
   AND record_state='draft')
 OR EXISTS(SELECT 1 FROM private.iclub_ai_v21_editorial_tickets
  WHERE ticket_id=pub_ticket AND used_at IS NOT NULL) THEN
  RAISE EXCEPTION 'Half-published source/release or used ticket after injected failure';
 END IF;
 EXECUTE 'DROP TRIGGER synthetic_editorial_publish_fail ON private.iclub_ai_topic_release_v21';
 ret:=public.publish_iclub_ai_v21_ticket(pub_ticket,0);
 IF ret->>'ok' IS DISTINCT FROM 'true'
 OR ret->>'publication_revision'<>'1' THEN
  RAISE EXCEPTION 'Signed exact source not published: %',ret;END IF;
 IF NOT EXISTS(SELECT 1 FROM private.iclub_ai_v21_editorial_tickets
 WHERE ticket_id=pub_ticket AND used_at IS NOT NULL) THEN
  RAISE EXCEPTION 'Ticket not marked used atomically';END IF;
 ret:=public.publish_iclub_ai_v21_ticket(pub_ticket,0);
 IF ret->>'reason' IS DISTINCT FROM 'ticket_unavailable' THEN
  RAISE EXCEPTION 'Publication ticket replayed: %',ret;END IF;
 ret:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF ret->>'approved' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Valid independent source/proof still not ready: %',ret;END IF;
 -- Editorial ready does NOT override independent owner-owned AI kill switch.
 UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=true,ui_enabled=false,gateway_enabled=false WHERE id=1;
 ret:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF ret->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Published source bypassed runtime OFF switch: %',ret;END IF;
 UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=false,ui_enabled=true,gateway_enabled=true WHERE id=1;
 ret:=public.get_iclub_ai_topic_release_service_v21(
 'lesson','biology','topic_explanation','lesson_101','uz');
 IF ret->>'ready' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'RU publication silently enabled UZ: %',ret;END IF;
 ret:=public.mint_iclub_ai_v21_lesson_context_service(learner,101);
 IF ret->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Cannot mint verified synthetic learner screen: %',ret;END IF;
 h:=ret->>'context_handle';
 ret:=public.get_iclub_ai_v21_source_bundle_service(
 learner,h,'synthetic-review-01','v1',digest,1,'ru','prepared','topic_main');
 IF ret->>'approved' IS DISTINCT FROM 'true'
 OR ret #>> '{prepared_variants,topic_main}'<>'Synthetic prepared result, not academic content.' THEN
  RAISE EXCEPTION 'Approved source not delivered to matching learner: %',ret;END IF;
 -- An independent new ticket cannot re-approve an already live topic.
 INSERT INTO private.iclub_ai_v21_editorial_tickets(
 ticket_id,surface_code,subject_key,feature_code,topic_key,locale,
 source_id,source_version,source_hash,action,qa_evidence)
 SELECT second_ticket,surface_code,subject_key,feature_code,topic_key,
 locale,source_id,source_version,source_hash,'publish',qa_evidence
 FROM private.iclub_ai_v21_editorial_tickets WHERE ticket_id=pub_ticket;
 INSERT INTO private.iclub_ai_v21_ticket_signoffs(ticket_id,reviewer_id,review_domain)
 VALUES(second_ticket,reviewer_content,'content'),
 (second_ticket,reviewer_rights,'rights'),
 (second_ticket,reviewer_technical,'technical');
 ret:=public.publish_iclub_ai_v21_ticket(second_ticket,1);
 IF ret->>'reason' IS DISTINCT FROM 'revision_or_state_conflict' THEN
  RAISE EXCEPTION 'Already-live topic was overwritten by another ticket: %',ret;END IF;

 -- Emergency suspension needs its own pre-approved safety ticket and reason.
 INSERT INTO private.iclub_ai_v21_editorial_tickets(
 ticket_id,surface_code,subject_key,feature_code,topic_key,locale,
 source_id,source_version,source_hash,action,reason)
 VALUES(revoke_ticket,'lesson','biology','topic_explanation',
 'lesson_101','ru','synthetic-review-01','v1',digest,'revoke','');
 ret:=public.revoke_iclub_ai_v21_ticket(revoke_ticket,1);
 IF ret->>'reason' IS DISTINCT FROM 'revocation_ticket_unavailable' THEN
  RAISE EXCEPTION 'Unsigned emergency revocation accepted: %',ret;END IF;
 INSERT INTO private.iclub_ai_v21_ticket_signoffs(ticket_id,reviewer_id,review_domain)
 VALUES(revoke_ticket,reviewer_safety,'safety');
 UPDATE private.iclub_ai_v21_editorial_tickets
 SET reason='Safety editor: suspend synthetic source integrity.'
 WHERE ticket_id=revoke_ticket;
 ret:=public.revoke_iclub_ai_v21_ticket(revoke_ticket,999);
 IF ret->>'reason' IS DISTINCT FROM 'revision_or_state_conflict' THEN
  RAISE EXCEPTION 'Wrong revocation revision was accepted: %',ret;END IF;
 ret:=public.revoke_iclub_ai_v21_ticket(revoke_ticket,1);
 IF ret->>'ok' IS DISTINCT FROM 'true'
 OR ret->>'publication_revision'<>'2' THEN
  RAISE EXCEPTION 'Safety-approved suspension failed: %',ret;END IF;
 ret:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF ret->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Suspended topic still approved: %',ret;END IF;
 ret:=public.get_iclub_ai_v21_source_bundle_service(
 learner,h,'synthetic-review-01','v1',digest,1,'ru','prepared','topic_main');
 IF ret->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Old session still reads revoked content: %',ret;END IF;
 ret:=public.revoke_iclub_ai_v21_ticket(revoke_ticket,2);
 IF ret->>'reason' IS DISTINCT FROM 'revocation_ticket_unavailable' THEN
  RAISE EXCEPTION 'Safety ticket can be replayed: %',ret;END IF;
 ret:=public.publish_iclub_ai_v21_ticket(second_ticket,2);
 IF ret->>'reason' IS DISTINCT FROM 'source_identity_unverified' THEN
  RAISE EXCEPTION 'Quarantined source republished without review: %',ret;END IF;
 RAISE NOTICE 'Governed ticket publication, three independent signoffs and emergency revoke GREEN';
END $ticket_test$;
ROLLBACK;
\echo 'Publisher scratch test rolled back. No editorial content or production data touched.'
