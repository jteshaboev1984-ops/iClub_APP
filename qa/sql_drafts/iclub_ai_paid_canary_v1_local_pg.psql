\set ON_ERROR_STOP on
-- Brand-new disposable localhost PG database only.
DO $roles$
DECLARE r text;
BEGIN
 FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=r)
  THEN EXECUTE format('CREATE ROLE %I NOLOGIN',r);END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA IF NOT EXISTS private;
\ir iclub_ai_paid_canary_v1_UNAPPLIED.sql
BEGIN;
DO $checks$
DECLARE x jsonb;rid uuid;
BEGIN
 rid:='11111111-1111-4111-8111-111111111111';
 IF has_function_privilege('anon','public.reserve_iclub_ai_paid_canary_v1(uuid)','EXECUTE') OR
    has_function_privilege('authenticated','public.status_iclub_ai_paid_canary_v1()','EXECUTE') OR
    has_table_privilege('service_role','private.iclub_ai_paid_canary_ledger_v1','INSERT')
 THEN RAISE EXCEPTION 'role isolation failed';END IF;
 SELECT public.reserve_iclub_ai_paid_canary_v1(rid) INTO x;
 IF x->>'reason'<>'not_authorized' THEN RAISE EXCEPTION 'anonymous reserve %',x;END IF;
 PERFORM set_config('request.jwt.claim.role','service_role',true);
 SELECT public.reserve_iclub_ai_paid_canary_v1(rid) INTO x;
 IF x->>'reason'<>'disabled' THEN RAISE EXCEPTION 'default disabled failed %',x;END IF;
 UPDATE private.iclub_ai_paid_canary_control_v1 SET enabled=true;
 SELECT public.reserve_iclub_ai_paid_canary_v1(rid) INTO x;
 IF x->>'allowed'<>'true' THEN RAISE EXCEPTION 'reserve1 %',x;END IF;
 SELECT public.reserve_iclub_ai_paid_canary_v1(rid) INTO x;
 IF x->>'reason'<>'request_already_seen' THEN RAISE EXCEPTION 'replay %',x;END IF;
 SELECT public.dispatch_iclub_ai_paid_canary_v1(rid) INTO x;
 IF x->>'allowed'<>'true' THEN RAISE EXCEPTION 'dispatch1 %',x;END IF;
 SELECT public.dispatch_iclub_ai_paid_canary_v1(rid) INTO x;
 IF x->>'allowed'<>'false' THEN RAISE EXCEPTION 'double dispatch %',x;END IF;
 SELECT public.finish_iclub_ai_paid_canary_v1(rid,'no_charge',NULL) INTO x;
 IF x->>'ok'<>'false' THEN RAISE EXCEPTION 'dispatched incorrectly refunded %',x;END IF;
 SELECT public.finish_iclub_ai_paid_canary_v1(rid,'charged',600) INTO x;
 IF x->>'ok'<>'true' THEN RAISE EXCEPTION 'invoice1 %',x;END IF;
 SELECT public.finish_iclub_ai_paid_canary_v1(rid,'charged',600) INTO x;
 IF x->>'duplicate'<>'true' THEN RAISE EXCEPTION 'invoice replay %',x;END IF;
 SELECT public.status_iclub_ai_paid_canary_v1() INTO x;
 IF (x->>'lifetime_microusd')::bigint<>600 THEN RAISE EXCEPTION 'invoice meter %',x;END IF;
 -- Reserve two, reject third, refund only never-dispatched money.
 SELECT public.reserve_iclub_ai_paid_canary_v1('22222222-2222-4222-8222-222222222222') INTO x;
 IF x->>'allowed'<>'true' THEN RAISE EXCEPTION 'reserve2 %',x;END IF;
 SELECT public.reserve_iclub_ai_paid_canary_v1('33333333-3333-4333-8333-333333333333') INTO x;
 IF x->>'allowed'<>'true' THEN RAISE EXCEPTION 'reserve3 %',x;END IF;
 SELECT public.reserve_iclub_ai_paid_canary_v1('44444444-4444-4444-8444-444444444444') INTO x;
 IF x->>'reason'<>'concurrency_limit' THEN RAISE EXCEPTION 'third concurrency %',x;END IF;
 SELECT public.finish_iclub_ai_paid_canary_v1('33333333-3333-4333-8333-333333333333','no_charge',NULL) INTO x;
 IF x->>'ok'<>'true' THEN RAISE EXCEPTION 'never-dispatched refund %',x;END IF;
 SELECT public.dispatch_iclub_ai_paid_canary_v1('22222222-2222-4222-8222-222222222222') INTO x;
 IF x->>'allowed'<>'true' THEN RAISE EXCEPTION 'dispatch2 %',x;END IF;
 SELECT public.finish_iclub_ai_paid_canary_v1('22222222-2222-4222-8222-222222222222','unknown',NULL) INTO x;
 IF x->>'ok'<>'true' THEN RAISE EXCEPTION 'unknown invoice %',x;END IF;
 SELECT public.status_iclub_ai_paid_canary_v1() INTO x;
 IF (x->>'lifetime_microusd')::bigint<>10600 THEN RAISE EXCEPTION 'unknown liability lost %',x;END IF;
 UPDATE private.iclub_ai_paid_canary_control_v1 SET max_actor_day_microusd=10000;
 SELECT public.reserve_iclub_ai_paid_canary_v1('55555555-5555-4555-8555-555555555555') INTO x;
 IF x->>'reason'<>'daily_limit' THEN RAISE EXCEPTION 'actor daily cap %',x;END IF;
 UPDATE private.iclub_ai_paid_canary_control_v1 SET max_day_microusd=10000;
 SELECT public.reserve_iclub_ai_paid_canary_v1('55555555-5555-4555-8555-555555555555') INTO x;
 IF x->>'reason'<>'daily_limit' THEN RAISE EXCEPTION 'global daily cap %',x;END IF;
 UPDATE private.iclub_ai_paid_canary_control_v1 SET max_lifetime_microusd=10000;
 SELECT public.reserve_iclub_ai_paid_canary_v1('55555555-5555-4555-8555-555555555555') INTO x;
 IF x->>'reason'<>'lifetime_limit' THEN RAISE EXCEPTION 'absolute cap %',x;END IF;
 RAISE NOTICE 'CANARY FINANCE PASS: role, zero-default, replay, money, unknown invoice, daily, total and 2-inflight';
END $checks$;
ROLLBACK;
