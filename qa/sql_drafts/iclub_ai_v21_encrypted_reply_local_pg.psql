-- Fully disposable real PostgreSQL: receipt and quota commit are ATOMIC.
\set ON_ERROR_STOP on
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL
  AND inet_server_addr() NOT IN('127.0.0.1'::inet,'::1'::inet)
  AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr
   AND current_setting('application_name')='iclub_ai_v21_local_scratch'))
 OR to_regclass('public.users') IS NOT NULL
 THEN RAISE EXCEPTION 'STOP: local empty scratch required';END IF;
END $guard$;
DO $roles$
DECLARE name text;
BEGIN
 FOREACH name IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=name) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',name);
  END IF;
 END LOOP;
END $roles$;
CREATE TABLE public.users(id uuid PRIMARY KEY);
\ir ../../supabase/migrations/20261006102000_iclub_global_ai_tariff_foundation_v1.sql
\ir iclub_ai_v21_meter_v2_UNAPPLIED.sql
\ir iclub_ai_delivery_claim_v21_UNAPPLIED.sql
\ir iclub_ai_v21_encrypted_reply_UNAPPLIED.sql
BEGIN;
INSERT INTO public.users VALUES('11111111-1111-4111-8111-111111111111');
CREATE FUNCTION private.synthetic_receipt_write_failure()
RETURNS trigger LANGUAGE plpgsql AS $trigger$
BEGIN
 RAISE EXCEPTION 'synthetic_receipt_insert_failed';
END $trigger$;
CREATE TRIGGER synthetic_fail_receipt
 BEFORE INSERT ON private.iclub_ai_v21_encrypted_reply_receipts
 FOR EACH ROW EXECUTE FUNCTION private.synthetic_receipt_write_failure();

DO $tests$
DECLARE
 uid uuid:='11111111-1111-4111-8111-111111111111';
 rid uuid:='22222222-2222-4222-8222-222222222222';
 sid text:=repeat('a',64);fp text:=repeat('b',64);
 digest text:=repeat('c',64);
 ct text:='abcdefghijklmnopqrstuvxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567';
 iv text:='abcdefghijklmnop';
 tag text:='abcdefghijklmnopqrstuv';
 v jsonb;failed boolean;
BEGIN
 IF has_function_privilege('anon',
  'public.get_iclub_ai_v21_encrypted_reply_service(uuid,uuid,text,text,text,text)','EXECUTE')
 OR has_function_privilege('authenticated',
  'public.finish_iclub_ai_delivery_with_receipt_service_v21(uuid,uuid,text,text,text,text,text,text,text,text)','EXECUTE')
 OR has_table_privilege('service_role',
  'private.iclub_ai_v21_encrypted_reply_receipts','SELECT')
 THEN RAISE EXCEPTION 'Ciphertext table leaked to learners';END IF;
 v:=public.get_iclub_ai_v21_encrypted_reply_service(rid,uid,sid,fp,'prepared',digest);
 IF v->>'available' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unknown or incomplete receipt returned';END IF;
 v:=public.reserve_iclub_ai_usage_service_v2(rid,uid,'plus_qa_v2','prepared',fp);
 IF v->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'reserve %',v;END IF;
 v:=public.claim_iclub_ai_delivery_service_v21(rid,uid,sid,fp,'prepared');
 IF v->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'claim %',v;END IF;
 failed:=false;
 BEGIN
  v:=public.finish_iclub_ai_delivery_with_receipt_service_v21(
   rid,uid,sid,fp,'prepared',digest,ct,iv,tag,'synthetic_key_01');
 EXCEPTION WHEN OTHERS THEN
  IF SQLERRM NOT LIKE '%synthetic_receipt_insert_failed%' THEN RAISE;END IF;
  failed:=true;
 END;
 IF NOT failed THEN RAISE EXCEPTION 'Injected receipt failure was not reached';END IF;
 IF NOT EXISTS(SELECT 1 FROM private.iclub_ai_usage_reservations
  WHERE request_id=rid AND status='reserved')
 OR NOT EXISTS(SELECT 1 FROM private.iclub_ai_request_tombstones_v21
  WHERE request_id=rid AND status='claimed')
 OR EXISTS(SELECT 1 FROM private.iclub_ai_v21_encrypted_reply_receipts
  WHERE request_id=rid)
 THEN RAISE EXCEPTION 'Half-written ciphertext or charged learner on failed receipt';END IF;
 EXECUTE 'DROP TRIGGER synthetic_fail_receipt ON private.iclub_ai_v21_encrypted_reply_receipts';
 v:=public.finish_iclub_ai_delivery_with_receipt_service_v21(
   rid,uid,sid,fp,'prepared',digest,ct,iv,tag,'synthetic_key_01');
 IF v->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'atomic finish %',v;END IF;
 IF NOT EXISTS(SELECT 1 FROM private.iclub_ai_usage_reservations
  WHERE request_id=rid AND status='completed')
 OR NOT EXISTS(SELECT 1 FROM private.iclub_ai_request_tombstones_v21
  WHERE request_id=rid AND status='completed')
 THEN RAISE EXCEPTION 'Quota and receipt did not complete together';END IF;
 v:=public.get_iclub_ai_v21_encrypted_reply_service(rid,uid,sid,fp,'prepared',digest);
 IF v->>'available' IS DISTINCT FROM 'true' OR v->>'ciphertext'<>ct
 THEN RAISE EXCEPTION 'Safe ciphertext not recoverable %',v;END IF;
 IF v ? 'reply' OR v ? 'source_text' OR v ? 'user_id'
 THEN RAISE EXCEPTION 'Unencrypted content / internal metadata leaked';END IF;
 v:=public.get_iclub_ai_v21_encrypted_reply_service(rid,uid,sid,fp,'prepared',repeat('d',64));
 IF v->>'available' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Wrong source digest accepted';END IF;
 v:=public.get_iclub_ai_v21_encrypted_reply_service(rid,uid,repeat('z',64),fp,'prepared',digest);
 IF v->>'available' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Wrong session accepted';END IF;
 v:=public.finish_iclub_ai_delivery_with_receipt_service_v21(
  rid,uid,sid,fp,'prepared',digest,ct,iv,tag,'synthetic_key_01');
 IF v->>'ok' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Duplicate receipt committed';END IF;
 UPDATE private.iclub_ai_v21_encrypted_reply_receipts
 SET created_at=now()-interval '3 minutes',
 expires_at=now()-interval '1 minute' WHERE request_id=rid;
 v:=public.get_iclub_ai_v21_encrypted_reply_service(rid,uid,sid,fp,'prepared',digest);
 IF v->>'available' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Expired cipher visible';END IF;
 RAISE NOTICE '§34 encrypted atomic reply receipt, rollback, replay, tenant and TTL GREEN';
END $tests$;
ROLLBACK;
\echo '§34 encrypted receipt synthetic fixture rolled back, production unchanged.'
