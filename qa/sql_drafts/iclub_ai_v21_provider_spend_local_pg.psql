-- Native scratch-only monetary liability test, including real user-meter +
-- first-writer tombstones. No paid calls / no real students.
\set ON_ERROR_STOP on
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL
  AND inet_server_addr() NOT IN ('127.0.0.1'::inet,'::1'::inet)
  AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr
   AND current_setting('application_name')='iclub_ai_v21_local_scratch'))
 OR to_regclass('public.users') IS NOT NULL
 THEN RAISE EXCEPTION 'STOP: empty local scratch required';END IF;
END $guard$;
DO $roles$
DECLARE x text;
BEGIN
 FOREACH x IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=x) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',x);
  END IF;
 END LOOP;
END $roles$;
CREATE TABLE public.users(id uuid PRIMARY KEY);
\ir ../../supabase/migrations/20261006102000_iclub_global_ai_tariff_foundation_v1.sql
\ir iclub_ai_v21_meter_v2_UNAPPLIED.sql
\ir iclub_ai_delivery_claim_v21_UNAPPLIED.sql
-- Use actual v1 private.iclub_global_ai_runtime_config installed above.
CREATE TABLE private.iclub_ai_v21_release_control(
 id smallint PRIMARY KEY,release_approved boolean NOT NULL DEFAULT false);
CREATE TABLE private.synthetic_protected_exam(user_id uuid PRIMARY KEY,active boolean NOT NULL);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(p_user_id uuid)
 RETURNS boolean LANGUAGE sql STABLE SET search_path=''
 AS $$ SELECT coalesce((SELECT active FROM private.synthetic_protected_exam
  WHERE user_id=p_user_id),false) $$;
\ir iclub_ai_v21_provider_spend_UNAPPLIED.sql
BEGIN;
INSERT INTO public.users VALUES('11111111-1111-4111-8111-111111111111');
DO $tests$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 sid text:=repeat('a',64);fp text:=repeat('b',64);
 rid uuid;v jsonb;spent bigint;failed boolean;
BEGIN
 IF has_function_privilege('anon','public.reserve_iclub_ai_v21_provider_spend_service(uuid,uuid,text,text)','EXECUTE')
 OR has_function_privilege('authenticated','public.dispatch_iclub_ai_v21_provider_spend_service(uuid,uuid,text,text)','EXECUTE')
 OR has_table_privilege('service_role','private.iclub_ai_v21_provider_spend_control','UPDATE')
 OR has_table_privilege('service_role','private.iclub_ai_v21_provider_spend_leases','INSERT')
 THEN RAISE EXCEPTION 'Provider spending roles insufficiently isolated';END IF;

 -- No app release, budget config, quota or claim => absolutely no paid route.
 rid:='10000000-0000-4000-8000-000000000001';
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Absent budget control granted paid call';END IF;
 INSERT INTO private.iclub_ai_v21_provider_spend_control
 VALUES(1,false,200,80,200,200,2,'synthetic_budget_only');
 INSERT INTO private.iclub_ai_v21_release_control VALUES(1,true);
 UPDATE private.iclub_global_ai_runtime_config SET
  kill_switch=false,ui_enabled=true,gateway_enabled=true,generation_enabled=true;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unapproved budget became active';END IF;
 UPDATE private.iclub_ai_v21_provider_spend_control SET enabled=true;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'reason' IS DISTINCT FROM 'request_claim_unverified' THEN
  RAISE EXCEPTION 'Missing quota/claim admitted provider: %',v;END IF;

 -- First exact request reserves learner quota -> claim -> money ceiling.
 v:=public.reserve_iclub_ai_usage_service_v2(rid,u,'plus_qa_v2','generated',fp);
 IF v->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'quota1 %',v;END IF;
 v:=public.claim_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated');
 IF v->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'claim1 %',v;END IF;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'money1 %',v;END IF;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'reason' IS DISTINCT FROM 'provider_request_already_seen' THEN
  RAISE EXCEPTION 'Same ID reserved money twice';END IF;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,repeat('c',64));
 IF v->>'reason' IS DISTINCT FROM 'request_identity_mismatch' THEN
  RAISE EXCEPTION 'Money lease wrong identity accepted';END IF;
 INSERT INTO private.synthetic_protected_exam VALUES(u,true);
 v:=public.dispatch_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Protected exam dispatched provider';END IF;
 UPDATE private.synthetic_protected_exam SET active=false WHERE user_id=u;
 v:=public.dispatch_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'dispatch1 %',v;END IF;
 v:=public.dispatch_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Two paid dispatches allowed';END IF;
 v:=public.finish_iclub_ai_v21_provider_spend_service(rid,u,sid,fp,'no_charge',NULL);
 IF v->>'reason' IS DISTINCT FROM 'unsafe_settlement' THEN
  RAISE EXCEPTION 'Dispatched provider money incorrectly released';END IF;
 v:=public.finish_iclub_ai_v21_provider_spend_service(rid,u,sid,fp,'charged',40);
 IF v->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'Known charge %',v;END IF;
 v:=public.finish_iclub_ai_v21_provider_spend_service(rid,u,sid,fp,'charged',40);
 IF v->>'ok' IS DISTINCT FROM 'true' OR v->>'duplicate' IS DISTINCT FROM 'true'
 THEN RAISE EXCEPTION 'Same money settled twice';END IF;
 -- Revenue/user allowance and provider money are independently settled.
 v:=public.finish_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated','completed');
 IF v->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'quota1 settle %',v;END IF;

 -- Second actual call is unknown: count FULL 80, release learner quota.
 rid:='10000000-0000-4000-8000-000000000002';
 v:=public.reserve_iclub_ai_usage_service_v2(rid,u,'plus_qa_v2','generated',fp);
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'quota2 %',v;END IF;
 v:=public.claim_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated');
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'claim2 %',v;END IF;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'money2 %',v;END IF;
 v:=public.dispatch_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'dispatch2 %',v;END IF;
 v:=public.finish_iclub_ai_v21_provider_spend_service(rid,u,sid,fp,'unknown',NULL);
 IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'unknown money liability %',v;END IF;
 v:=public.finish_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated','released');
 IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'learner refund %',v;END IF;
 SELECT sum(CASE WHEN state='charged' THEN actual_microusd
   WHEN state='no_charge' THEN 0 ELSE held_microusd END)
 INTO spent FROM private.iclub_ai_v21_provider_spend_leases;
 IF spent<>120 THEN RAISE EXCEPTION '40 known + 80 unknown must count 120, got %',spent;END IF;

 -- 80 remaining (200-120), third hold80 permitted, fourth must reject.
 rid:='10000000-0000-4000-8000-000000000003';
 v:=public.reserve_iclub_ai_usage_service_v2(rid,u,'plus_qa_v2','generated',fp);
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'quota3 %',v;END IF;
 v:=public.claim_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated');
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'claim3 %',v;END IF;
 -- The very same request must be refused by the UTC global daily cap
 -- and by the per-user daily cap before it can consume money.
 UPDATE private.iclub_ai_v21_provider_spend_control
 SET daily_cap_microusd=150,per_user_daily_cap_microusd=150;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'reason' IS DISTINCT FROM 'provider_daily_budget_insufficient'
 THEN RAISE EXCEPTION 'Global UTC daily limit failed %',v;END IF;
 UPDATE private.iclub_ai_v21_provider_spend_control
 SET daily_cap_microusd=200,per_user_daily_cap_microusd=150;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'reason' IS DISTINCT FROM 'provider_daily_budget_insufficient'
 THEN RAISE EXCEPTION 'Per-user UTC daily limit failed %',v;END IF;
 UPDATE private.iclub_ai_v21_provider_spend_control
 SET per_user_daily_cap_microusd=200;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'money3 %',v;END IF;
 -- Released only if never dispatched and provider definitively uncalled.
 v:=public.finish_iclub_ai_v21_provider_spend_service(rid,u,sid,fp,'no_charge',NULL);
 IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'Never called provider release %',v;END IF;
 v:=public.finish_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated','released');
 IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'quota3 release %',v;END IF;

 -- Global OFF revokes provider dispatch but cannot block account reconciliation.
 UPDATE private.iclub_global_ai_runtime_config SET kill_switch=true;
 rid:='10000000-0000-4000-8000-000000000004';
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Kill switch allowed money reservation';END IF;
 UPDATE private.iclub_global_ai_runtime_config SET kill_switch=false;
 -- Budget can be lowered in scratch for negative test. Real policy NEVER set here.
 UPDATE private.iclub_ai_v21_provider_spend_control SET
   lifetime_cap_microusd=120,daily_cap_microusd=120,
   per_user_daily_cap_microusd=120;
 v:=public.reserve_iclub_ai_usage_service_v2(rid,u,'plus_qa_v2','generated',fp);
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'quota4 %',v;END IF;
 v:=public.claim_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated');
 IF v->>'allowed'<>'true' THEN RAISE EXCEPTION 'claim4 %',v;END IF;
 v:=public.reserve_iclub_ai_v21_provider_spend_service(rid,u,sid,fp);
 IF v->>'reason' IS DISTINCT FROM 'provider_budget_insufficient' THEN
  RAISE EXCEPTION 'Spending ceiling ignored: %',v;END IF;
 v:=public.finish_iclub_ai_delivery_service_v21(rid,u,sid,fp,'generated','released');
 IF v->>'ok'<>'true' THEN RAISE EXCEPTION 'Denied money left user charged';END IF;
 RAISE NOTICE 'P8 finance: lifetime, UTC day, user day, exact claim, unknown liability and refunds GREEN';
END $tests$;
ROLLBACK;
\echo 'Money fixture rolled back; no real provider/user data used.'
