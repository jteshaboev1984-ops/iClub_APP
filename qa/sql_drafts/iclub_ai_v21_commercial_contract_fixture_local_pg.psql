-- §101 isolated schema-compatible commercial contract fixture.
-- Included ONLY after synthetic PG Home tables exist and ONLY in scratch.
-- These records emulate real iClub existing guard/slot/capabilities shapes.
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 THEN RAISE EXCEPTION 'STOP: scratch database only'; END IF;
END $guard$;

-- Source-audited live public subjects has 'type'; local stripped fixture did not.
ALTER TABLE public.subjects ADD COLUMN type text NOT NULL DEFAULT 'main';
ALTER TABLE public.user_subjects
 ADD COLUMN created_at timestamptz NOT NULL DEFAULT now();

CREATE TABLE private.iclub_commercial_access_config(
 id smallint PRIMARY KEY,
 policy_version text NOT NULL,
 subject_limits_mode text NOT NULL,
 grandfather_snapshot_completed_at timestamptz,
 updated_at timestamptz NOT NULL
);
INSERT INTO private.iclub_commercial_access_config VALUES
 (1,'synthetic-contract-v1','enforced',now(),now());

-- Stored subject selection is seeded by the common Home SQL scratch fixture.

-- This table is SYNTHETIC: in real iClub capabilities are derived from
-- entitlements, canary and plan_policies by an existing SECURITY DEFINER.
CREATE TABLE private.iclub_ai_qa_capabilities_fixture(
 user_id uuid PRIMARY KEY,
 resolved boolean NOT NULL,
 plan_code text NOT NULL,
 plan_source text NOT NULL,
 ai_generation_entitled boolean NOT NULL,
 all_available_subjects boolean NOT NULL
);
INSERT INTO private.iclub_ai_qa_capabilities_fixture VALUES
 ('11111111-1111-4111-8111-111111111111',true,'pro','explicit_entitlement',true,false);

-- Separate AI feature approval is NOT an existing live user entitlement.
-- Simulates an independently scoped QA-only rollout; NEVER copy to live DB.
CREATE TABLE private.iclub_ai_qa_home_feature_gate(
 user_id uuid PRIMARY KEY,approved boolean NOT NULL DEFAULT false,
 revision bigint NOT NULL DEFAULT 1
);
INSERT INTO private.iclub_ai_qa_home_feature_gate VALUES
 ('11111111-1111-4111-8111-111111111111',true,1);

REVOKE ALL ON private.iclub_commercial_access_config,
 private.iclub_subject_slot_selections,
 private.iclub_ai_qa_capabilities_fixture,
 private.iclub_ai_qa_home_feature_gate FROM PUBLIC,anon,authenticated;

CREATE OR REPLACE FUNCTION public.get_iclub_subscription_capabilities_service_v1(
 p_user_id uuid
) RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $body$
 SELECT COALESCE((
  SELECT jsonb_build_object('resolved',c.resolved,'plan_code',c.plan_code,
   'plan_source',c.plan_source,'ai_generation_entitled',c.ai_generation_entitled,
   'all_available_subjects',c.all_available_subjects)
  FROM private.iclub_ai_qa_capabilities_fixture c WHERE c.user_id=p_user_id
 ),'{"resolved":false,"reason":"unresolved"}'::jsonb)
$body$;
REVOKE ALL ON FUNCTION public.get_iclub_subscription_capabilities_service_v1(uuid)
 FROM PUBLIC,anon,authenticated;

-- Contract shape mirrors the real service's open intent, including
-- legacy_passthrough/shadow/subject_selected/plan_all_subjects branches.
-- Commercial LIMIT selection APIs are deliberately not imitated as grants.
CREATE OR REPLACE FUNCTION public.get_iclub_subject_access_guard_service_v1(
 p_user_id uuid,p_subject_key text,p_intent text
) RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $body$
DECLARE cfg record;subj record; caps jsonb; chosen boolean;
BEGIN
 IF p_user_id IS NULL OR p_subject_key IS NULL OR
  p_intent NOT IN ('open','select_study','select_competitive')
 THEN RETURN jsonb_build_object('allowed',false,'reason','invalid_request');END IF;
 SELECT * INTO cfg FROM private.iclub_commercial_access_config WHERE id=1;
 IF NOT FOUND OR cfg.subject_limits_mode='off'
 THEN RETURN jsonb_build_object('allowed',true,'mode','legacy_passthrough',
  'reason','subject_limits_off'); END IF;
 IF cfg.subject_limits_mode='enforced' AND cfg.grandfather_snapshot_completed_at IS NULL
 THEN RETURN jsonb_build_object('allowed',true,'mode','legacy_passthrough',
  'reason','grandfather_snapshot_incomplete');END IF;
 SELECT * INTO subj FROM public.subjects WHERE subject_key=p_subject_key;
 IF NOT FOUND OR NOT subj.is_active
 THEN RETURN jsonb_build_object('allowed',false,'reason','subject_unavailable');END IF;
 caps:=public.get_iclub_subscription_capabilities_service_v1(p_user_id);
 IF coalesce((caps->>'resolved')::boolean,false) IS NOT TRUE
 THEN RETURN jsonb_build_object('allowed',cfg.subject_limits_mode='shadow',
  'mode',CASE WHEN cfg.subject_limits_mode='shadow' THEN 'shadow' ELSE 'commercial' END,
  'reason','subscription_unresolved');END IF;
 IF p_intent<>'open' THEN
  RETURN jsonb_build_object('allowed',true,'mode',cfg.subject_limits_mode,
   'reason',CASE WHEN p_intent='select_study' THEN 'study_slot_available'
     ELSE 'competitive_slot_available' END);
 END IF;
 IF (caps->>'all_available_subjects')::boolean
 THEN RETURN jsonb_build_object('allowed',true,
  'mode',CASE WHEN cfg.subject_limits_mode='shadow' THEN 'shadow' ELSE 'commercial' END,
  'reason','plan_all_subjects');END IF;
 SELECT study_selected INTO chosen FROM private.iclub_subject_slot_selections
 WHERE user_id=p_user_id AND subject_key=p_subject_key;
 IF coalesce(chosen,false)
 THEN RETURN jsonb_build_object('allowed',true,
  'mode',CASE WHEN cfg.subject_limits_mode='shadow' THEN 'shadow' ELSE 'commercial' END,
  'reason','subject_selected'); END IF;
 RETURN jsonb_build_object('allowed',cfg.subject_limits_mode='shadow',
  'mode',CASE WHEN cfg.subject_limits_mode='shadow' THEN 'shadow' ELSE 'commercial' END,
  'reason','subject_not_selected');
END $body$;
REVOKE ALL ON FUNCTION public.get_iclub_subject_access_guard_service_v1(
 uuid,text,text) FROM PUBLIC,anon,authenticated;

-- Unified authenticated service snapshot: no client-supplied booleans,
-- no user academic rows leaked, only server-authoritative checks.
CREATE OR REPLACE FUNCTION public.get_iclub_ai_v21_commercial_snapshot_scratch_service(
 p_user uuid,p_subject text,p_intent text
) RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path='' AS $snap$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$' OR
  p_user IS NULL OR p_subject !~ '^[a-z][a-z0-9_]{1,79}$' OR
  p_intent NOT IN ('study','competitive')
 THEN RETURN jsonb_build_object('allowed',false);END IF;
 RETURN jsonb_build_object(
  'guard',public.get_iclub_subject_access_guard_service_v1(
    p_user,p_subject,'open'),
  'capabilities',public.get_iclub_subscription_capabilities_service_v1(p_user),
  'config',(
   SELECT jsonb_build_object('subjectLimitsMode',cfg.subject_limits_mode,
    'grandfatherSnapshotCompleted',cfg.grandfather_snapshot_completed_at IS NOT NULL,
    'revision',floor(extract(epoch from cfg.updated_at))::bigint)
   FROM private.iclub_commercial_access_config cfg WHERE cfg.id=1),
  'enrollment',(
   SELECT jsonb_build_object('userId',us.user_id,'subjectKey',sj.subject_key,
    'mode',us.mode,'active',sj.is_active AND EXISTS(
     SELECT 1 FROM private.iclub_ai_v21_home_synthetic_access a
     WHERE a.user_id=us.user_id AND a.subject_key=sj.subject_key
      AND a.intent=us.mode AND a.allowed),
    'revision',floor(extract(epoch from us.created_at))::bigint)
   FROM public.user_subjects us
   JOIN public.subjects sj ON sj.id=us.subject_id
   WHERE us.user_id=p_user AND sj.subject_key=p_subject
   LIMIT 1),
  'slot',(
   SELECT jsonb_build_object('userId',sl.user_id,'subjectKey',sl.subject_key,
    'studySelected',sl.study_selected,'competitiveSelected',sl.competitive_selected,
    'revision',floor(extract(epoch from sl.updated_at))::bigint)
   FROM private.iclub_subject_slot_selections sl
   WHERE sl.user_id=p_user AND sl.subject_key=p_subject),
  'subjectRecord',(
   SELECT jsonb_build_object('subjectKey',sj.subject_key,'isActive',sj.is_active,
    'type',sj.type)
   FROM public.subjects sj WHERE sj.subject_key=p_subject LIMIT 1),
  'featureGate',(
   SELECT jsonb_build_object('origin','trusted_qa_server_only',
    'scope','isolated_qa_only','feature','home_next_actions',
    'approved',g.approved,'productionAllowed',false,'revision',g.revision)
   FROM private.iclub_ai_qa_home_feature_gate g WHERE g.user_id=p_user)
 );
END $snap$;
REVOKE ALL ON FUNCTION public.get_iclub_ai_v21_commercial_snapshot_scratch_service(
 uuid,text,text) FROM PUBLIC,anon,authenticated;
GRANT EXECUTE ON FUNCTION public.get_iclub_ai_v21_commercial_snapshot_scratch_service(
 uuid,text,text) TO service_role;
