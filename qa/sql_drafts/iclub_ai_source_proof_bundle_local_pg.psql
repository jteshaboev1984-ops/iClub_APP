 (920,921,false,now()),(930,931,false,now());


\ir iclub_ai_topic_release_gate_v21_UNAPPLIED.sql
\ir iclub_ai_source_proof_bundle_v21_UNAPPLIED.sql
UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=false,ui_enabled=true,gateway_enabled=true;
DO $source_cases$
DECLARE
 learner uuid:='11111111-1111-4111-8111-111111111111';
 stranger uuid:='22222222-2222-4222-8222-222222222222';
 reviewer uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 prepared jsonb:='{"explain_error":"Synthetic routing test receipt, not a question or lesson."}'::jsonb;
 source_body text:='Synthetic integration source only. No academic teaching material.';
 digest_hash text;
 handle text;
 biology_handle text;
 econ_handle text;
 d jsonb;
BEGIN
 digest_hash:=encode(sha256(convert_to(
    source_body||E'\n'||prepared::text,'UTF8')),'hex');
 d:=public.mint_iclub_ai_v21_lesson_context_service(learner,101);
 IF d->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'Cannot mint synthetic lesson: %',d;END IF;
 biology_handle:=d->>'context_handle';
 d:=public.get_iclub_ai_v21_source_proof_service(
   'lesson','biology','topic_explanation','lesson_101','ru');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Unpublished source opened: %',d;END IF;
 INSERT INTO private.iclub_ai_v21_editorial_source_versions(
 surface_code,subject_key,feature_code,topic_key,locale,
 source_id,source_version,source_hash,source_text,prepared_variants,
 rights_approved,qa_passed,integrity_verified,runtime_allowed,
 source_conflict,record_state)
 VALUES('lesson','biology','topic_explanation','lesson_101','ru',
 'synthetic-editorial-001','v1',digest_hash,source_body,prepared,
 true,true,true,true,false,'published');
 d:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Source row itself granted readiness: %',d;END IF;
 INSERT INTO private.iclub_ai_topic_release_v21(
 surface_code,subject_key,feature_code,topic_key,locale,source_id,source_version,source_hash,
 content_approved,rights_approved,source_version_verified,correctness_passed,
 negative_tests_passed,exam_security_passed,locale_verified,accessibility_passed,
 publication_state,feature_enabled,approved_by,approved_at)
 VALUES('lesson','biology','topic_explanation','lesson_101','ru',
 'synthetic-editorial-001','v1',digest_hash,
 true,true,true,true,true,true,true,true,
 'approved',true,reviewer,now());
 d:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF d->>'approved' IS DISTINCT FROM 'true' OR d->>'source_hash'<>digest_hash THEN
  RAISE EXCEPTION 'Exact approved hash proof failed: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'true'
 OR d #>> '{prepared_variants,explain_error}' IS DISTINCT FROM
   'Synthetic routing test receipt, not a question or lesson.'
 OR d->>'source_text'<>'' THEN
  RAISE EXCEPTION 'Prepared reply not exact/small: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','prepared','unknown_prompt');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unknown card guessed instead of in-development: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','generated','');
 IF d->>'approved' IS DISTINCT FROM 'true' OR d->>'source_text'<>source_body
 OR d->'prepared_variants'<>'{}'::jsonb THEN
  RAISE EXCEPTION 'Generated route did not isolate source-only payload: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 stranger,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign learner obtained payload: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'uz','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unpublished UZ locale borrowed RU source: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',repeat('0',64),
 1,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Client-forged hash accepted: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 2,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Outdated publication revision accepted: %',d;END IF;
 -- Source body mutation with stale claimed digest must NOT pass.
 UPDATE private.iclub_ai_v21_editorial_source_versions
 SET source_text='Modified after approval!' WHERE subject_key='biology';
 d:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Source digest tamper did not revoke proof: %',d;END IF;
 UPDATE private.iclub_ai_v21_editorial_source_versions
 SET source_text=source_body,rights_approved=false WHERE subject_key='biology';
 d:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Rights revocation did not disable proof: %',d;END IF;
 UPDATE private.iclub_ai_v21_editorial_source_versions
 SET rights_approved=true WHERE subject_key='biology';
 UPDATE private.iclub_ai_topic_release_v21
 SET feature_enabled=false WHERE subject_key='biology';
 d:=public.get_iclub_ai_v21_source_proof_service(
 'lesson','biology','topic_explanation','lesson_101','ru');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Technical feature disable did not close source: %',d;END IF;
 UPDATE private.iclub_ai_topic_release_v21
 SET feature_enabled=true WHERE subject_key='biology';
 -- Opening Economics screen invalidates previously published Biology handle.
 d:=public.mint_iclub_ai_v21_lesson_context_service(learner,103);
 IF d->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Second subject navigation failed: %',d;END IF;
 econ_handle:=d->>'context_handle';
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,biology_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Old Biology screen still gets approved text: %',d;END IF;
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,econ_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Economics borrowed Biology source: %',d;END IF;
 -- Separate protected assessment guard denies freshly approved contexts.
 INSERT INTO private.context_qa_exam_flags(user_id,active) VALUES(learner,true);
 d:=public.get_iclub_ai_v21_source_bundle_service(
 learner,econ_handle,'synthetic-editorial-001','v1',digest_hash,
 1,'ru','prepared','explain_error');
 IF d->>'approved' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Exam leaked AI payload: %',d;END IF;
 RAISE NOTICE 'Independent editorial proof + exactly scoped payload + live revoke GREEN';
END $source_cases$;
ROLLBACK;
\echo 'Source bridge synthetic fixture rolled back; no real content or users were created.'
