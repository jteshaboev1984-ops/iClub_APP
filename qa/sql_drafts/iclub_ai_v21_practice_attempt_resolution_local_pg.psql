\set ON_ERROR_STOP on
-- Independent disposable PostgreSQL 16 matrix; no real users or production DB.
BEGIN;
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_'
 OR to_regclass('public.practice_sessions_v4') IS NOT NULL
 THEN RAISE EXCEPTION 'Requires empty disposable QA database'; END IF;
END $guard$;
DO $roles$
DECLARE r text;
BEGIN
 FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=r)
  THEN EXECUTE format('CREATE ROLE %I NOLOGIN',r); END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA private;
CREATE TABLE private.iclub_global_ai_runtime_config(
 id int PRIMARY KEY,kill_switch boolean,gateway_enabled boolean);
INSERT INTO private.iclub_global_ai_runtime_config VALUES(1,true,false);
CREATE TABLE private.qa_protected(user_id uuid,active boolean);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(u uuid)
RETURNS boolean LANGUAGE sql STABLE SET search_path='' AS
$$SELECT coalesce((SELECT active FROM private.qa_protected WHERE user_id=u),false)$$;
CREATE TABLE public.subjects(id bigint PRIMARY KEY,is_active boolean);
CREATE TABLE public.user_subjects(user_id uuid,subject_id bigint);
CREATE TABLE public.practice_sessions_v4(
 id bigint PRIMARY KEY,user_id uuid,subject_id bigint,status text,
 finalized_at timestamptz,question_ids bigint[],legacy_attempt_id bigint);
CREATE TABLE public.practice_session_answers_v4(
 session_id bigint,question_id bigint,answered_at timestamptz,is_correct boolean);
INSERT INTO public.subjects VALUES(10,true);
INSERT INTO public.user_subjects VALUES('11111111-1111-4111-8111-111111111111',10);
INSERT INTO public.practice_sessions_v4 VALUES
 (900,'11111111-1111-4111-8111-111111111111',10,'finalized',now(),ARRAY[901],99),
 (910,'11111111-1111-4111-8111-111111111111',10,'active',NULL,ARRAY[911],100);
INSERT INTO public.practice_session_answers_v4 VALUES
 (900,901,now(),false),(910,911,now(),false);
\ir iclub_ai_v21_practice_attempt_resolution_UNAPPLIED.sql
DO $closed$
BEGIN
 IF public.resolve_iclub_ai_v21_practice_attempt_service(
 '11111111-1111-4111-8111-111111111111',99,901)->>'ok'<>'false'
 THEN RAISE EXCEPTION 'Disabled AI must not resolve'; END IF;
END $closed$;
UPDATE private.iclub_global_ai_runtime_config
SET kill_switch=false,gateway_enabled=true;
DO $test$
DECLARE u uuid:='11111111-1111-4111-8111-111111111111';
 x jsonb;
BEGIN
 x:=public.resolve_iclub_ai_v21_practice_attempt_service(u,99,901);
 IF x->>'ok'<>'true' OR x->>'sessionId'<>'900'
 OR x->>'questionId'<>'901' OR x->>'attemptReference'<>'99'
 THEN RAISE EXCEPTION 'Canonical V4 mapping incorrect'; END IF;
 IF has_function_privilege('authenticated',
  'public.resolve_iclub_ai_v21_practice_attempt_service(uuid,bigint,bigint)','EXECUTE')
 THEN RAISE EXCEPTION 'Learner direct function access'; END IF;
 FOR x IN
  SELECT public.resolve_iclub_ai_v21_practice_attempt_service(u,100,911)
  UNION ALL SELECT public.resolve_iclub_ai_v21_practice_attempt_service(u,99,999)
  UNION ALL SELECT public.resolve_iclub_ai_v21_practice_attempt_service(
   '22222222-2222-4222-8222-222222222222',99,901)
 LOOP
  IF x->>'ok'<>'false' THEN RAISE EXCEPTION 'Unsafe Practice lookup'; END IF;
 END LOOP;
END $test$;
INSERT INTO private.qa_protected VALUES('11111111-1111-4111-8111-111111111111',true);
DO $blocked$
BEGIN
 IF public.resolve_iclub_ai_v21_practice_attempt_service(
 '11111111-1111-4111-8111-111111111111',99,901)->>'ok'<>'false'
 THEN RAISE EXCEPTION 'Active assessment must block AI'; END IF;
END $blocked$;
UPDATE private.qa_protected SET active=false;
UPDATE public.subjects SET is_active=false WHERE id=10;
DO $inactive$
BEGIN
 IF public.resolve_iclub_ai_v21_practice_attempt_service(
 '11111111-1111-4111-8111-111111111111',99,901)->>'ok'<>'false'
 THEN RAISE EXCEPTION 'Inactive subject must refuse resolver'; END IF;
END $inactive$;
UPDATE public.subjects SET is_active=true WHERE id=10;
DELETE FROM public.user_subjects;
DO $unenrolled$
BEGIN
 IF public.resolve_iclub_ai_v21_practice_attempt_service(
 '11111111-1111-4111-8111-111111111111',99,901)->>'ok'<>'false'
 THEN RAISE EXCEPTION 'Withdrawn enrollment must refuse resolver'; END IF;
END $unenrolled$;
INSERT INTO public.user_subjects VALUES('11111111-1111-4111-8111-111111111111',10);
UPDATE public.practice_session_answers_v4 SET answered_at=NULL
 WHERE session_id=900 AND question_id=901;
DO $unanswered$
BEGIN
 IF public.resolve_iclub_ai_v21_practice_attempt_service(
 '11111111-1111-4111-8111-111111111111',99,901)->>'ok'<>'false'
 THEN RAISE EXCEPTION 'Unanswered question must refuse resolver'; END IF;
END $unanswered$;
UPDATE public.practice_session_answers_v4 SET answered_at=now()
 WHERE session_id=900 AND question_id=901;
-- Ambiguous legacy attempts never resolve to whichever session is first.
INSERT INTO public.practice_sessions_v4 VALUES
(930,'11111111-1111-4111-8111-111111111111',10,'finalized',now(),ARRAY[901],99);
INSERT INTO public.practice_session_answers_v4 VALUES(930,901,now(),true);
DO $ambiguous$
BEGIN
 IF public.resolve_iclub_ai_v21_practice_attempt_service(
 '11111111-1111-4111-8111-111111111111',99,901)->>'ok'<>'false'
 THEN RAISE EXCEPTION 'Ambiguous legacy attempt must be rejected'; END IF;
END $ambiguous$;
ROLLBACK;
\echo ICLUB_AI_V21_PRACTICE_MAPPING_LOCAL_GREEN
