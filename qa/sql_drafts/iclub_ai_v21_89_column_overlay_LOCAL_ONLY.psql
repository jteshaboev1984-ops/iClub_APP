-- §117: 89-column exact type/nullability replica, no learner records. Scratch ONLY.
DO $q$ BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 THEN RAISE EXCEPTION 'STOP disposable PostgreSQL ONLY'; END IF;
END $q$;
