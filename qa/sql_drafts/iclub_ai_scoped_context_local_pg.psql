-- iClub AI v2.1: local PostgreSQL synthetic context flow; one ROLLBACK.
-- NO REAL STUDENT RECORDS. Nothing ever applied to production.
\set ON_ERROR_STOP on
BEGIN;
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL
  AND inet_server_addr() NOT IN ('127.0.0.1'::inet,'::1'::inet)
  AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr
   AND current_setting('application_name')='iclub_ai_v21_local_scratch')) THEN
  RAISE EXCEPTION 'STOP: context tests only on isolated localhost scratch';
 END IF;
 IF to_regclass('public.practice_sessions_v4') IS NOT NULL
 OR to_regclass('private.iclub_ai_v21_scoped_contexts') IS NOT NULL THEN
  RAISE EXCEPTION 'STOP: nonempty PostgreSQL test database';
 END IF;
END $guard$;

DO $roles$
DECLARE x text;
BEGIN
 FOREACH x IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=x) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',x);
  END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA IF NOT EXISTS private;
CREATE TABLE private.iclub_global_ai_runtime_config(
 id int primary key,kill_switch boolean not null,
 ui_enabled boolean not null,gateway_enabled boolean not null);
INSERT INTO private.iclub_global_ai_runtime_config
 VALUES (1,true,false,false);
CREATE TABLE public.users(id uuid primary key,first_name text);
CREATE TABLE public.subjects(
 id bigint primary key,subject_key text not null,is_active boolean not null);
CREATE TABLE public.lessons(id bigint primary key,subject_id bigint not null);
CREATE TABLE public.user_subjects(
 user_id uuid not null,subject_id bigint not null,
 mode text not null DEFAULT 'study',is_pinned boolean not null DEFAULT false,
 primary key(user_id,subject_id));
CREATE TABLE public.practice_sessions_v4(
 id bigint primary key,user_id uuid not null,subject_id bigint not null,
 status text not null,finalized_at timestamptz,
 question_ids bigint[] not null);
CREATE TABLE public.practice_session_answers_v4(
 session_id bigint not null,question_id bigint not null,
 primary key(session_id,question_id));
CREATE TABLE public.tours(id bigint primary key,subject_id bigint not null,
 end_date date,is_active boolean);
CREATE TABLE public.tour_attempts(id bigint primary key,user_id uuid not null,
 tour_id bigint not null,status text not null);
CREATE TABLE public.tour_session_runtime_v4(attempt_id bigint primary key,
 user_id uuid not null,tour_id bigint not null,finalized_at timestamptz);
CREATE TABLE private.context_qa_exam_flags(
 user_id uuid primary key,active boolean not null);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(p_user_id uuid)
RETURNS boolean LANGUAGE sql STABLE SET search_path=''
AS $$SELECT coalesce((SELECT active FROM private.context_qa_exam_flags
 WHERE user_id=p_user_id),false)$$;
\ir iclub_ai_scoped_context_v21_UNAPPLIED.sql
\ir iclub_ai_v21_real_schema_screen_proof_UNAPPLIED.sql

