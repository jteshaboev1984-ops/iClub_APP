DO $cases$
DECLARE
 learner uuid:='11111111-1111-4111-8111-111111111111';
 stranger uuid:='22222222-2222-4222-8222-222222222222';
 result jsonb;
 first_handle text;
 second_handle text;
 econ_handle text;
 lesson_handle text;
 tour_handle text;
 view_handle text;
BEGIN
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,901);
 IF result->>'reason' IS DISTINCT FROM 'global_ai_disabled' THEN
  RAISE EXCEPTION 'Kill switch failed: %',result;END IF;
 UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=false,ui_enabled=true,gateway_enabled=true;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'No current screen may be available before mint: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(stranger,900,901);
 IF result->>'reason' IS DISTINCT FROM 'practice_context_not_authorized' THEN
  RAISE EXCEPTION 'Foreign session minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,902);
 IF result->>'reason' IS DISTINCT FROM 'practice_context_not_authorized' THEN
  RAISE EXCEPTION 'Unanswered item minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,920,921);
 IF result->>'reason' IS DISTINCT FROM 'practice_context_not_authorized' THEN
  RAISE EXCEPTION 'Unfinalized exam minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,901);
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR length(result->>'context_handle')<>36 THEN
  RAISE EXCEPTION 'Finished Biology context not minted: %',result;END IF;
 first_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result#>>'{evidence,context_handle}' IS DISTINCT FROM first_handle
 OR result#>>'{evidence,context_revision}' IS DISTINCT FROM 'screen_1'
 OR result#>>'{evidence,current_view}' IS DISTINCT FROM 'courses'
 OR (result#>>'{evidence,revision}')::bigint<>1 THEN
  RAISE EXCEPTION 'Owner-bound first screen proof mismatch: %',result; END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(stranger,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign account read another active screen: %',result; END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,901);
 IF result->>'duplicate' IS DISTINCT FROM 'true'
 OR result->>'context_handle' IS DISTINCT FROM first_handle THEN
  RAISE EXCEPTION 'Same question was not idempotent: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result #>> '{context,subject}'<>'biology'
 OR result #>> '{context,topic}'<>'question_901'
 OR result #>> '{context,feature}'<>'answer_explanation'
 OR result #>> '{context,current_view}'<>'courses'
 OR result #>> '{context,practice_session_id}'<>'900'
 OR result #>> '{context,question_id}'<>'901'
 OR result #>> '{context,lesson_id}' IS NOT NULL THEN
  RAISE EXCEPTION 'Wrong server context: %',result;END IF;
 IF result::text ~* 'user_answer|picked_index|correct_answer|grade|score' THEN
  RAISE EXCEPTION 'Academic answer/progress leaked';END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(stranger,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign learner resolved first context: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,'malformed-handle');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Malformed context admitted: %',result;END IF;

 -- Lesson context exists BEFORE editorial AI content is ready, and its
 -- identity comes from the real lessons/subjects/enrollment tables.
 result:=public.mint_iclub_ai_v21_lesson_context_service(stranger,101);
 IF result->>'reason' IS DISTINCT FROM 'lesson_context_not_authorized' THEN
  RAISE EXCEPTION 'Foreign learner minted Biology Lesson: %',result;END IF;
 result:=public.mint_iclub_ai_v21_lesson_context_service(learner,99999);
 IF result->>'reason' IS DISTINCT FROM 'lesson_context_not_authorized' THEN
  RAISE EXCEPTION 'Nonexistent lesson minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_lesson_context_service(learner,101);
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Owned Biology lesson not minted: %',result;END IF;
 lesson_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result#>>'{evidence,context_handle}' IS DISTINCT FROM lesson_handle
 OR result#>>'{evidence,context_revision}' IS DISTINCT FROM 'screen_2' THEN
  RAISE EXCEPTION 'Navigation did not atomically replace current screen: %',result;END IF;
 result:=public.mint_iclub_ai_v21_lesson_context_service(learner,101);
 IF result->>'duplicate' IS DISTINCT FROM 'true'
 OR result->>'context_handle' IS DISTINCT FROM lesson_handle THEN
  RAISE EXCEPTION 'Lesson duplicate not idempotent: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,lesson_handle);
 IF result #>> '{context,surface}'<>'lesson'
 OR result #>> '{context,topic}'<>'lesson_101'
 OR result #>> '{context,feature}'<>'topic_explanation'
 OR result #>> '{context,lesson_id}'<>'101'
 OR result #>> '{context,practice_session_id}' IS NOT NULL THEN
  RAISE EXCEPTION 'Incorrect verified Biology Lesson context: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Entering Lesson did not revoke previous Practice screen: %',result;END IF;
 -- Opening Economics Practice closes the previously verified Lesson context.
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,910,911);
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Finished Economics context not minted: %',result;END IF;
 econ_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,lesson_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Leaving Lesson did not revoke old context: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Old Biology context remained valid after navigation: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result #>> '{context,subject}'<>'economics' THEN
  RAISE EXCEPTION 'New Economics screen lost: %',result;END IF;
 result:=public.revoke_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'ok' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Old tab revoked newer active screen: %',result;END IF;

 -- Retrospective changes in Practice ownership, membership and exams still
 -- invalidate the handle; no separate Academic write is performed by RPC.
 UPDATE public.practice_sessions_v4 SET status='in_progress',finalized_at=NULL WHERE id=910;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'In-progress activity reopened AI: %',result;END IF;
 UPDATE public.practice_sessions_v4 SET status='finalized',finalized_at=now() WHERE id=910;
 DELETE FROM public.user_subjects WHERE user_id=learner AND subject_id=12;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Removed subject membership retained AI: %',result;END IF;
 INSERT INTO public.user_subjects(user_id,subject_id) VALUES (learner,12);
 INSERT INTO private.context_qa_exam_flags VALUES(learner,true);
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Protected exam failed to close AI: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,910,911);
 IF result->>'reason' IS DISTINCT FROM 'active_assessment' THEN
  RAISE EXCEPTION 'Protected assessment minted a context: %',result;END IF;
 UPDATE private.context_qa_exam_flags SET active=false WHERE user_id=learner;
 UPDATE public.subjects SET is_active=false WHERE id=12;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Deactivated subject retained AI: %',result;END IF;
 UPDATE public.subjects SET is_active=true WHERE id=12;
 UPDATE private.iclub_ai_v21_scoped_contexts
 SET expires_at=now()-interval '1 second'
 WHERE context_handle=econ_handle::uuid;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Expired screen still live: %',result; END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Expired AI context reopened: %',result;END IF;

 result:=public.mint_iclub_ai_v21_practice_context_service(learner,930,931);
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Informatics topic could not mint: %',result;END IF;
 second_handle:=result->>'context_handle';
 result:=public.revoke_iclub_ai_v21_scoped_context_service(stranger,second_handle);
 IF result->>'ok' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign user revoked context: %',result;END IF;
 result:=public.revoke_iclub_ai_v21_scoped_context_service(learner,second_handle);
 IF result->>'ok' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Owner could not leave screen: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Revoked handle left live current screen: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,second_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Revoked handle remained valid: %',result;END IF;

 -- Tour archive has the SAME owner-bound current-screen handle lifecycle.
 FOR result IN
  SELECT public.mint_iclub_ai_v21_tour_archive_context_service(stranger,401)
  UNION ALL SELECT public.mint_iclub_ai_v21_tour_archive_context_service(learner,402)
  UNION ALL SELECT public.mint_iclub_ai_v21_tour_archive_context_service(learner,403)
  UNION ALL SELECT public.mint_iclub_ai_v21_tour_archive_context_service(learner,405)
  UNION ALL SELECT public.mint_iclub_ai_v21_tour_archive_context_service(learner,404)
 LOOP IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Closed, active, foreign or nonfinal Tour minted AI: %',result;END IF;END LOOP;
 result:=public.mint_iclub_ai_v21_tour_archive_context_service(learner,401);
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Open owned Tour not minted: %',result;END IF;
 tour_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,tour_handle);
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result#>>'{context,surface}'<>'tour_archive'
 OR result#>>'{context,topic}'<>'tour_40_archive'
 OR result#>>'{context,tour_attempt_id}'<>'401'
 OR result#>>'{context,current_view}'<>'courses' THEN
  RAISE EXCEPTION 'Tour scoped metadata invalid: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result#>>'{evidence,context_handle}' IS DISTINCT FROM tour_handle THEN
  RAISE EXCEPTION 'Tour current-screen proof missing: %',result;END IF;
 result:=public.mint_iclub_ai_v21_tour_archive_context_service(learner,401);
 IF result->>'duplicate' IS DISTINCT FROM 'true'
 OR result->>'context_handle' IS DISTINCT FROM tour_handle THEN
  RAISE EXCEPTION 'Tour mint not idempotent: %',result;END IF;
 UPDATE public.tour_session_runtime_v4 SET finalized_at=NULL WHERE attempt_id=401;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,tour_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Tour lost finalization but AI remained active: %',result;END IF;
 UPDATE public.tour_session_runtime_v4 SET finalized_at=now() WHERE attempt_id=401;
 UPDATE public.tours SET end_date=(now() AT TIME ZONE 'Asia/Tashkent')::date WHERE id=40;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Reclosed Tour archive still has AI proof: %',result;END IF;
 UPDATE public.tours SET end_date=(now() AT TIME ZONE 'Asia/Tashkent')::date-1 WHERE id=40;
 result:=public.revoke_iclub_ai_v21_scoped_context_service(learner,tour_handle);
 IF result->>'ok' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Tour owner unable to revoke handle: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Revoked Tour current-screen still live: %',result;END IF;

 -- §50: one existing current-screen lifecycle for Profile, Home and Help.
 result:=public.mint_iclub_ai_v21_app_view_context_service(stranger,'profile');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unknown/foreign profile minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_app_view_context_service(learner,'invented_tab');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unrecognized screen minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_app_view_context_service(learner,'profile');
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Existing profile failed mint: %',result;END IF;
 view_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,view_handle);
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result#>>'{context,surface}'<>'profile'
 OR result#>>'{context,subject}'<>'general'
 OR result#>>'{context,current_view}'<>'profile'
 OR result#>>'{context,topic}'<>'progress' THEN
  RAISE EXCEPTION 'Profile screen scope incorrect: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result#>>'{evidence,current_view}' IS DISTINCT FROM 'profile'
 OR result#>>'{evidence,context_handle}' IS DISTINCT FROM view_handle THEN
  RAISE EXCEPTION 'Profile screen revision or handle incorrect: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'profile_aggregate');
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result#>>'{evidence,verified}'<>'true'
 OR result#>>'{evidence,metrics,0,count}'<>'1'
 OR result#>>'{evidence,metrics,1,count}'<>'1'
 OR result#>>'{evidence,metrics,2,count}'<>'2' THEN
  RAISE EXCEPTION 'Factual profile counters wrong: %',result;END IF;
 IF result::text ~* 'PRIVATE_NAME_EXAMPLE|first_name|login|user_answer|grade|score|percent|trend|stability' THEN
  RAISE EXCEPTION 'Private or unverified profile data leaked: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(stranger,'profile_aggregate');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign profile metrics visible: %',result;END IF;
 result:=public.mint_iclub_ai_v21_app_view_context_service(learner,'profile');
 IF result->>'duplicate' IS DISTINCT FROM 'true'
 OR result->>'context_handle' IS DISTINCT FROM view_handle THEN
  RAISE EXCEPTION 'Profile duplicate mint not idempotent: %',result;END IF;
 result:=public.mint_iclub_ai_v21_app_view_context_service(learner,'home');
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Home screen context failed: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'profile_aggregate');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Profile proof survived navigation: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'home_next_actions');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unapproved Home next-action plan created: %',result;END IF;
 result:=public.mint_iclub_ai_v21_app_view_context_service(learner,'about');
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Navigation help handle failed: %',result;END IF;
 view_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,view_handle);
 IF result#>>'{context,surface}'<>'global'
 OR result#>>'{context,feature}'<>'app_help'
 OR result#>>'{context,current_view}'<>'about' THEN
  RAISE EXCEPTION 'General Help context misrouted: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'navigation',p_view=>'about');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Unapproved navigation instructions released: %',result;END IF;
 INSERT INTO private.context_qa_exam_flags VALUES(learner,true);
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Global AI screen available during protected assessment: %',result;END IF;
 DELETE FROM private.context_qa_exam_flags WHERE user_id=learner;
 result:=public.revoke_iclub_ai_v21_scoped_context_service(learner,view_handle);
 IF result->>'ok' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'General Help handle failed to revoke: %',result;END IF;
 result:=public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Revoked General Help context remained live: %',result;END IF;

 -- Abuse prevention: 30 new context rows in a minute blocks more mints.
 INSERT INTO private.iclub_ai_v21_scoped_contexts(
  context_handle,user_id,surface_code,subject_key,feature_code,topic_key,
  practice_session_id,practice_question_id,context_revision)
 SELECT gen_random_uuid(),learner,'practice','biology',
  'answer_explanation','question_901',900,901,1
 FROM generate_series(1,30);
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,901);
 IF result->>'reason' IS DISTINCT FROM 'context_rate_limited' THEN
  RAISE EXCEPTION 'Browser could mass mint 30+ contexts: %',result; END IF;
 RAISE NOTICE 'Scoped Practice context mint/resolve/revoke, switch, idempotency and rate limits GREEN';
END $cases$;
ROLLBACK;
\echo 'Scoped context fixture fully rolled back. NOT applied to Supabase.'
