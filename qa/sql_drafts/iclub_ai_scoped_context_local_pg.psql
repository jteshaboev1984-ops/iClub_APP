-- iClub AI v2.1: local PostgreSQL synthetic context flow; one ROLLBACK.
-- NO REAL STUDENT RECORDS. Nothing ever applied to production.
\set ON_ERROR_STOP on
BEGIN;
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL
  AND inet_server_addr() NOT IN ('127.0.0.1'::inet,'::1'::inet)
  AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr
   AND current_setting('application_name')='iclub_ai_v21_local_scratch')) THEN
  RAISE EXCEPTION 'STOP: context tests only on isolated localhost scratch';
 END IF;
 IF to_regclass('public.practice_sessions_v4') IS NOT NULL
 OR to_regclass('private.iclub_ai_v21_scoped_contexts') IS NOT NULL THEN
  RAISE EXCEPTION 'STOP: nonempty PostgreSQL test database';
 END IF;
END $guard$;

DO $roles$
DECLARE x text;
BEGIN
 FOREACH x IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=x) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',x);
  END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA IF NOT EXISTS private;
CREATE TABLE private.iclub_global_ai_runtime_config(
 id int primary key,kill_switch boolean not null,
 ui_enabled boolean not null,gateway_enabled boolean not null);
INSERT INTO private.iclub_global_ai_runtime_config
 VALUES (1,true,false,false);
CREATE TABLE public.subjects(
 id bigint primary key,subject_key text not null,is_active boolean not null);
CREATE TABLE public.user_subjects(
 user_id uuid not null,subject_id bigint not null,
 primary key(user_id,subject_id));
CREATE TABLE public.practice_sessions_v4(
 id bigint primary key,user_id uuid not null,subject_id bigint not null,
 status text not null,finalized_at timestamptz,
 question_ids bigint[] not null);
CREATE TABLE public.practice_session_answers_v4(
 session_id bigint not null,question_id bigint not null,
 primary key(session_id,question_id));
CREATE TABLE private.context_qa_exam_flags(
 user_id uuid primary key,active boolean not null);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(p_user_id uuid)
RETURNS boolean LANGUAGE sql STABLE SET search_path=''
AS $$SELECT coalesce((SELECT active FROM private.context_qa_exam_flags
 WHERE user_id=p_user_id),false)$$;
\ir iclub_ai_scoped_context_v21_UNAPPLIED.sql

INSERT INTO public.subjects VALUES
 (10,'biology',true),(11,'chemistry',true),(12,'economics',true),(13,'informatics',true);
INSERT INTO public.user_subjects VALUES
 ('11111111-1111-4111-8111-111111111111',10),
 ('11111111-1111-4111-8111-111111111111',11),
 ('11111111-1111-4111-8111-111111111111',12),
 ('11111111-1111-4111-8111-111111111111',13);
INSERT INTO public.practice_sessions_v4 VALUES
 (900,'11111111-1111-4111-8111-111111111111',10,'finalized',now(),ARRAY[901,902]),
 (910,'11111111-1111-4111-8111-111111111111',12,'finalized',now(),ARRAY[911]),
 (920,'11111111-1111-4111-8111-111111111111',11,'in_progress',NULL,ARRAY[921]),
 (930,'11111111-1111-4111-8111-111111111111',13,'finalized',now(),ARRAY[931]);
INSERT INTO public.practice_session_answers_v4 VALUES
 (900,901),(910,911),(920,921),(930,931);

DO $cases$
DECLARE
 learner uuid:='11111111-1111-4111-8111-111111111111';
 stranger uuid:='22222222-2222-4222-8222-222222222222';
 result jsonb;
 first_handle text;
 second_handle text;
 econ_handle text;
BEGIN
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,901);
 IF result->>'reason' IS DISTINCT FROM 'global_ai_disabled' THEN
  RAISE EXCEPTION 'Kill switch failed: %',result;END IF;
 UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=false,ui_enabled=true,gateway_enabled=true;
 result:=public.mint_iclub_ai_v21_practice_context_service(stranger,900,901);
 IF result->>'reason' IS DISTINCT FROM 'practice_context_not_authorized' THEN
  RAISE EXCEPTION 'Foreign session minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,902);
 IF result->>'reason' IS DISTINCT FROM 'practice_context_not_authorized' THEN
  RAISE EXCEPTION 'Unanswered item minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,920,921);
 IF result->>'reason' IS DISTINCT FROM 'practice_context_not_authorized' THEN
  RAISE EXCEPTION 'Unfinalized exam minted: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,900,901);
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR length(result->>'context_handle')<>36 THEN
  RAISE EXCEPTION 'Finished Biology context not minted: %',result;END IF;
 first_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'true'
 OR result #>> '{context,subject}'<>'biology'
 OR result #>> '{context,topic}'<>'question_901'
 OR result #>> '{context,feature}'<>'answer_explanation' THEN
  RAISE EXCEPTION 'Wrong server context: %',result;END IF;
 IF result::text ~* 'user_answer|picked_index|correct_answer|grade|score' THEN
  RAISE EXCEPTION 'Academic answer/progress leaked';END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(stranger,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign learner resolved first context: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,'malformed-handle');
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Malformed context admitted: %',result;END IF;

 -- Open a different subject; old screen must become invalid immediately.
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,910,911);
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Finished Economics context not minted: %',result;END IF;
 econ_handle:=result->>'context_handle';
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Old Biology context remained valid after navigation: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result #>> '{context,subject}'<>'economics' THEN
  RAISE EXCEPTION 'New Economics screen lost: %',result;END IF;
 result:=public.revoke_iclub_ai_v21_scoped_context_service(learner,first_handle);
 IF result->>'ok' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Old tab revoked newer active screen: %',result;END IF;

 -- Retrospective changes in Practice ownership, membership and exams still
 -- invalidate the handle; no separate Academic write is performed by RPC.
 UPDATE public.practice_sessions_v4 SET status='in_progress',finalized_at=NULL WHERE id=910;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'In-progress activity reopened AI: %',result;END IF;
 UPDATE public.practice_sessions_v4 SET status='finalized',finalized_at=now() WHERE id=910;
 DELETE FROM public.user_subjects WHERE user_id=learner AND subject_id=12;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Removed subject membership retained AI: %',result;END IF;
 INSERT INTO public.user_subjects VALUES (learner,12);
 INSERT INTO private.context_qa_exam_flags VALUES(learner,true);
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Protected exam failed to close AI: %',result;END IF;
 result:=public.mint_iclub_ai_v21_practice_context_service(learner,910,911);
 IF result->>'reason' IS DISTINCT FROM 'active_assessment' THEN
  RAISE EXCEPTION 'Protected assessment minted a context: %',result;END IF;
 UPDATE private.context_qa_exam_flags SET active=false WHERE user_id=learner;
 UPDATE public.subjects SET is_active=false WHERE id=12;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Deactivated subject retained AI: %',result;END IF;
 UPDATE public.subjects SET is_active=true WHERE id=12;
 UPDATE private.iclub_ai_v21_scoped_contexts
 SET expires_at=now()-interval '1 second'
 WHERE context_handle=econ_handle::uuid;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,econ_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Expired AI context reopened: %',result;END IF;

 result:=public.mint_iclub_ai_v21_practice_context_service(learner,930,931);
 IF result->>'allowed' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Informatics topic could not mint: %',result;END IF;
 second_handle:=result->>'context_handle';
 result:=public.revoke_iclub_ai_v21_scoped_context_service(stranger,second_handle);
 IF result->>'ok' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Foreign user revoked context: %',result;END IF;
 result:=public.revoke_iclub_ai_v21_scoped_context_service(learner,second_handle);
 IF result->>'ok' IS DISTINCT FROM 'true' THEN
  RAISE EXCEPTION 'Owner could not leave screen: %',result;END IF;
 result:=public.get_iclub_ai_v21_scoped_context_service(learner,second_handle);
 IF result->>'allowed' IS DISTINCT FROM 'false' THEN
  RAISE EXCEPTION 'Revoked handle remained valid: %',result;END IF;

 RAISE NOTICE 'Scoped Practice context mint/resolve/revoke and cross-subject race GREEN';
END $cases$;
ROLLBACK;
\echo 'Scoped context fixture fully rolled back. NOT applied to Supabase.'
