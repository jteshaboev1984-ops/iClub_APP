-- §120. Synthetic ONLY, called inside disposable scratch DB transaction.
-- This local fixture is NEVER approved as a production migration.
DO $guard$ BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 THEN RAISE EXCEPTION 'Synthetic HTTP fixture requires scratch'; END IF;
END $guard$;
