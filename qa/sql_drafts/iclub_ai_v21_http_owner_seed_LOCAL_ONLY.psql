CREATE TABLE private.qa_http_protected_assessment(
 user_id uuid PRIMARY KEY,active boolean NOT NULL DEFAULT false);
INSERT INTO private.qa_http_protected_assessment VALUES
 ('11111111-1111-4111-8111-111111111111',false),
 ('22222222-2222-4222-8222-222222222222',false);
CREATE OR REPLACE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(
 p_user_id uuid) RETURNS boolean LANGUAGE sql STABLE SET search_path=''
AS $qa$
 SELECT coalesce((SELECT active FROM private.qa_http_protected_assessment
 WHERE user_id=p_user_id),true)
$qa$;
-- Activate only the SYNTHETIC context gate in a database that will be dropped.
-- The separate release permission remains FALSE and budgets remain blocked.
UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=false,ui_enabled=true,gateway_enabled=true WHERE id=1;
DO $verify$
BEGIN
 IF EXISTS(SELECT 1 FROM private.iclub_ai_v21_release_control WHERE release_approved)
 THEN RAISE EXCEPTION 'Actual release approval must not be seeded';END IF;
 IF (SELECT count(*) FROM public.practice_session_answers_v4)<>2
 THEN RAISE EXCEPTION 'Synthetic answer count mismatch';END IF;
 RAISE NOTICE 'HTTP_PG_SYNTHETIC_SEED_READY: two fake owners, no provider release';
END $verify$;
