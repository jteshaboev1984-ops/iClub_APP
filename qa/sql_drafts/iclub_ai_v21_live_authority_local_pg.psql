-- Native PostgreSQL 16 local-only authority acceptance. NO real data.
\set ON_ERROR_STOP on
BEGIN;
DO $preflight$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL
  AND inet_server_addr() NOT IN ('127.0.0.1'::inet,'::1'::inet)
  AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr
   AND current_setting('application_name')='iclub_ai_v21_local_scratch'))
 OR to_regclass('private.iclub_ai_v21_release_control') IS NOT NULL
 THEN RAISE EXCEPTION 'STOP: empty localhost scratch required';END IF;
END $preflight$;
DO $roles$
DECLARE name text;
BEGIN
 FOREACH name IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=name) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',name);
  END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA private;
CREATE TABLE private.iclub_global_ai_runtime_config(
 id smallint PRIMARY KEY,ui_enabled boolean,gateway_enabled boolean,
 kill_switch boolean,global_ai_rollout_mode text);
INSERT INTO private.iclub_global_ai_runtime_config
 VALUES(1,false,false,true,'off');
CREATE TABLE public.subjects(id bigint PRIMARY KEY,subject_key text,is_active boolean);
CREATE TABLE public.user_subjects(user_id uuid,subject_id bigint);
CREATE TABLE private.synthetic_canary(user_id uuid PRIMARY KEY,canary boolean);
CREATE TABLE private.synthetic_exam(user_id uuid PRIMARY KEY,active boolean);
CREATE TABLE private.synthetic_access(subject text PRIMARY KEY,allowed boolean);
CREATE TABLE private.synthetic_caps(user_id uuid PRIMARY KEY,plan_code text,
 entitled boolean,resolved boolean);
CREATE FUNCTION private.iclub_rollout_allows_user_v1(
 p_user_id uuid,p_mode text) RETURNS boolean LANGUAGE sql STABLE SET search_path=''
AS $v1roll$
 SELECT CASE WHEN p_mode='all' THEN true WHEN p_mode='canary'
 THEN coalesce((SELECT canary FROM private.synthetic_canary WHERE user_id=p_user_id),false)
 ELSE false END
$v1roll$;
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(
 p_user_id uuid) RETURNS boolean LANGUAGE sql STABLE SET search_path=''
AS $v1protected$
 SELECT coalesce((SELECT active FROM private.synthetic_exam
 WHERE user_id=p_user_id),false)
$v1protected$;
CREATE FUNCTION public.get_iclub_subject_access_guard_service_v1(
 p_user_id uuid,p_subject text,p_intent text
) RETURNS jsonb LANGUAGE sql STABLE SET search_path=''
AS $v1access$
 SELECT jsonb_build_object('allowed',coalesce((
 SELECT allowed FROM private.synthetic_access WHERE subject=p_subject),false)
 AND p_intent='open')
$v1access$;
CREATE FUNCTION public.get_iclub_subscription_capabilities_service_v1(
 p_user_id uuid) RETURNS jsonb LANGUAGE sql STABLE SET search_path=''
AS $v1caps$
 SELECT jsonb_build_object(
  'resolved',coalesce((SELECT resolved FROM private.synthetic_caps WHERE user_id=p_user_id),false),
  'plan_code',(SELECT plan_code FROM private.synthetic_caps WHERE user_id=p_user_id),
  'ai_generation_entitled',coalesce((SELECT entitled
   FROM private.synthetic_caps WHERE user_id=p_user_id),false))
$v1caps$;
\ir iclub_ai_v21_live_authority_UNAPPLIED.sql
INSERT INTO public.subjects VALUES
 (10,'biology',true),(11,'chemistry',true),(12,'economics',true),(13,'informatics',true);
INSERT INTO private.synthetic_access VALUES
 ('biology',true),('chemistry',true),('economics',true),('informatics',false);
INSERT INTO private.synthetic_caps VALUES
 ('11111111-1111-4111-8111-111111111111','free',false,true),
 ('22222222-2222-4222-8222-222222222222','plus',true,true),
 ('33333333-3333-4333-8333-333333333333','pro',true,true),
 ('44444444-4444-4444-8444-444444444444','plus',false,true),
 ('55555555-5555-4555-8555-555555555555','ultra',true,true);
INSERT INTO private.synthetic_canary VALUES
 ('11111111-1111-4111-8111-111111111111',true);
INSERT INTO public.user_subjects VALUES
 ('11111111-1111-4111-8111-111111111111',10),
 ('11111111-1111-4111-8111-111111111111',11),
 ('11111111-1111-4111-8111-111111111111',12),
 ('11111111-1111-4111-8111-111111111111',13);
DO $acceptance$
DECLARE
 u uuid:='11111111-1111-4111-8111-111111111111';
 p uuid:='22222222-2222-4222-8222-222222222222';
 z jsonb;
 s text;
BEGIN
 IF has_function_privilege('anon','public.get_iclub_ai_v21_runtime_service()','EXECUTE')
 OR has_function_privilege('authenticated','public.get_iclub_ai_v21_entitlement_service(uuid)','EXECUTE')
 OR has_function_privilege('anon',
  'public.get_iclub_ai_v21_provider_budget_service(uuid,text,text)','EXECUTE')
 OR NOT has_function_privilege('service_role',
  'public.get_iclub_ai_v21_rollout_service(uuid,text,text,text,text)','EXECUTE')
 OR has_table_privilege('service_role','private.iclub_ai_v21_release_control','UPDATE')
 THEN RAISE EXCEPTION 'Function/table privileges not isolated';END IF;

 z:=public.get_iclub_ai_v21_runtime_service();
 IF z->>'kill_switch'<>'true' OR z->>'release_approved'<>'false' THEN
  RAISE EXCEPTION 'Default runtime not closed: %',z;END IF;
 IF (public.get_iclub_ai_v21_protected_service(NULL::uuid))->>'protected'<>'true'
 THEN RAISE EXCEPTION 'Null exam principal authorized';END IF;
 IF (public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','topic_explanation','lesson_101'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'OFF rollout admitted user';END IF;
 IF (public.get_iclub_ai_v21_entitlement_service(u))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'OFF entitlement admitted user';END IF;

 UPDATE private.iclub_global_ai_runtime_config
  SET ui_enabled=true,gateway_enabled=true,kill_switch=false,
      global_ai_rollout_mode='canary';
 -- Missing independent owner approval still blocks both.
 IF (public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','topic_explanation','lesson_101'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Missing owner release was bypassed';END IF;
 INSERT INTO private.iclub_ai_v21_release_control(id,release_approved)
 VALUES(1,false);
 IF (public.get_iclub_ai_v21_runtime_service())->>'release_approved'<>'false'
 THEN RAISE EXCEPTION 'Default release became public';END IF;
 UPDATE private.iclub_ai_v21_release_control
  SET release_approved=true,release_reference='synthetic-only',
   approved_at=now() WHERE id=1;
 z:=public.get_iclub_ai_v21_runtime_service();
 IF z->>'release_approved'<>'true' OR z->>'ui_enabled'<>'true'
 THEN RAISE EXCEPTION 'Synthetic separately approved runtime unusable: %',z;END IF;
 z:=public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','topic_explanation','lesson_101');
 IF z->>'allowed'<>'true' THEN
  RAISE EXCEPTION 'Verified Biology canary lesson denied: %',z;END IF;
 z:=public.get_iclub_ai_v21_rollout_service(
  u,'practice','economics','answer_explanation','question_900');
 IF z->>'allowed'<>'true' THEN
  RAISE EXCEPTION 'Verified Economics Practice denied: %',z;END IF;
 z:=public.get_iclub_ai_v21_rollout_service(
  u,'lesson','chemistry','topic_explanation','lesson_102');
 IF z->>'allowed'<>'true' THEN
  RAISE EXCEPTION 'Verified Chemistry Lesson denied: %',z;END IF;
 z:=public.get_iclub_ai_v21_rollout_service(
  u,'lesson','informatics','topic_explanation','lesson_104');
 IF z->>'allowed'<>'false' THEN
  RAISE EXCEPTION 'v1 subject-access guard was bypassed: %',z;END IF;
 FOR s IN SELECT unnest(ARRAY['', 'not_a_subject','math?','biology;drop'])
 LOOP
  IF (public.get_iclub_ai_v21_rollout_service(
   u,'lesson',s,'topic_explanation','lesson_101'))->>'allowed' IS DISTINCT FROM 'false'
  THEN RAISE EXCEPTION 'Bad subject accepted: %',s;END IF;
 END LOOP;
 IF (public.get_iclub_ai_v21_rollout_service(
  u,'tour','biology','topic_explanation','lesson_101'))->>'allowed'<>'false'
 OR (public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','answer_explanation','question_1'))->>'allowed'<>'false'
 OR (public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','topic_explanation','lesson_0'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Unimplemented surface/feature/topic escaped';END IF;
 IF (public.get_iclub_ai_v21_rollout_service(
  p,'lesson','biology','topic_explanation','lesson_101'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Unassigned/cohort user gained subject';END IF;

 z:=public.get_iclub_ai_v21_entitlement_service(u);
 IF z->>'usage_policy_code'<>'free_qa_v2'
 THEN RAISE EXCEPTION 'Free mapping failed: %',z;END IF;
 IF (public.get_iclub_ai_v21_entitlement_service(p))->>'allowed'<>'true'
 THEN RAISE EXCEPTION 'Plus subscription mapping failed';END IF;
 IF (public.get_iclub_ai_v21_entitlement_service(
  '33333333-3333-4333-8333-333333333333'))->>'usage_policy_code'<>'pro_qa_v2'
 THEN RAISE EXCEPTION 'Pro subscription mapping failed';END IF;
 IF (public.get_iclub_ai_v21_entitlement_service(
  '44444444-4444-4444-8444-444444444444'))->>'allowed'<>'false'
 OR (public.get_iclub_ai_v21_entitlement_service(
  '55555555-5555-4555-8555-555555555555'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Unapproved capability/plan admitted';END IF;

 INSERT INTO private.synthetic_exam VALUES(u,true);
 IF (public.get_iclub_ai_v21_protected_service(u))->>'protected'<>'true'
 OR (public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','topic_explanation','lesson_101'))->>'allowed'<>'false'
 OR (public.get_iclub_ai_v21_entitlement_service(u))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Protected exam failed closed';END IF;
 UPDATE private.synthetic_exam SET active=false WHERE user_id=u;
 DELETE FROM public.user_subjects WHERE user_id=u AND subject_id=10;
 IF (public.get_iclub_ai_v21_rollout_service(
  u,'lesson','biology','topic_explanation','lesson_101'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Subject removal failed closed';END IF;
 UPDATE public.subjects SET is_active=false WHERE id=12;
 IF (public.get_iclub_ai_v21_rollout_service(
  u,'practice','economics','answer_explanation','question_900'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Subject suspension failed closed';END IF;
 UPDATE private.iclub_global_ai_runtime_config SET kill_switch=true;
 IF (public.get_iclub_ai_v21_entitlement_service(u))->>'allowed'<>'false'
 OR (public.get_iclub_ai_v21_runtime_service())->>'kill_switch'<>'true'
 THEN RAISE EXCEPTION 'Kill switch did not disable v2';END IF;
 IF (public.get_iclub_ai_v21_provider_budget_service(
  u,'synthetic-source','generated'))->>'allowed'<>'false'
 THEN RAISE EXCEPTION 'Unapproved paid provider was enabled';END IF;
 RAISE NOTICE 'P8 runtime/protected/rollout/entitlement/budget SQL authority GREEN';
END $acceptance$;
ROLLBACK;
\echo 'Native authority suite ROLLED BACK. No Supabase or academic data changed.'
