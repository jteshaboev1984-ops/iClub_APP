-- iClub AI v2.1: REAL v1+v2 tariff plus durable delivery settlement.
-- Brand-new local scratch DB only. NO real users and NO production writes.
\set ON_ERROR_STOP on
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL AND
    inet_server_addr() NOT IN ('127.0.0.1'::inet,'::1'::inet)
    AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr
       AND current_setting('application_name')='iclub_ai_v21_local_scratch')) THEN
  RAISE EXCEPTION 'STOP: delivery/meter integration is scratch-only';
 END IF;
 IF to_regclass('private.iclub_ai_usage_reservations') IS NOT NULL
 OR to_regclass('public.users') IS NOT NULL THEN
  RAISE EXCEPTION 'STOP: existing application tables found';
 END IF;
END $guard$;
DO $roles$
DECLARE x text;
BEGIN
 FOREACH x IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname=x) THEN
   EXECUTE format('CREATE ROLE %I NOLOGIN',x);
 END IF;
 END LOOP;
END $roles$;
CREATE TABLE public.users(id uuid primary key);
\ir ../../supabase/migrations/20261006102000_iclub_global_ai_tariff_foundation_v1.sql
\ir iclub_ai_v21_meter_v2_UNAPPLIED.sql
\ir iclub_ai_delivery_claim_v21_UNAPPLIED.sql
BEGIN;
INSERT INTO public.users(id) VALUES('11111111-1111-4111-8111-111111111111');

CREATE FUNCTION private.iclub_ai_synthetic_commit_failure()
RETURNS trigger LANGUAGE plpgsql AS $fail$
BEGIN
 IF NEW.status='completed' AND
 NEW.request_id='44444444-4444-4444-8444-444444444444'::uuid THEN
   RAISE EXCEPTION 'synthetic_delivery_commit_failure';
 END IF;
 RETURN NEW;
END $fail$;
CREATE TRIGGER synthetic_fail_tombstone_after_quota
BEFORE UPDATE ON private.iclub_ai_request_tombstones_v21
FOR EACH ROW EXECUTE FUNCTION private.iclub_ai_synthetic_commit_failure();

DO $cases$
DECLARE
 learner uuid:='11111111-1111-4111-8111-111111111111';
 sid text:=repeat('a',64);
 fp text:=repeat('b',64);
 rid uuid;
 res jsonb;
 old_units integer;
 old_reserved integer;
 failed boolean;
BEGIN
 -- Generated weight = 3, and delivery completes in the same DB transaction.
 rid:='33333333-3333-4333-8333-333333333333';
 res:=public.reserve_iclub_ai_usage_service_v2(rid,learner,'plus_qa_v2','generated',fp);
 IF res->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'reservation 1: %',res; END IF;
 res:=public.claim_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'generated');
 IF res->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'claim 1: %',res;END IF;
 res:=public.finish_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'generated','completed');
 IF res->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'settle 1: %',res;END IF;
 SELECT committed_units,reserved_units INTO old_units,old_reserved
 FROM private.iclub_ai_usage_periods WHERE user_id=learner AND status='active';
 IF old_units IS DISTINCT FROM 3 OR old_reserved IS DISTINCT FROM 0 THEN
  RAISE EXCEPTION 'atomic 1: expected committed3 reserved0, got % %',old_units,old_reserved;END IF;
 IF NOT EXISTS (SELECT 1 FROM private.iclub_ai_usage_reservations
 WHERE request_id=rid AND status='completed') OR NOT EXISTS (
 SELECT 1 FROM private.iclub_ai_request_tombstones_v21
 WHERE request_id=rid AND status='completed') THEN
  RAISE EXCEPTION 'atomic 1: ledgers disagree';END IF;

 -- Force a tombstone write failure AFTER the usage finalize RPC call.
 -- Exception subtransaction must undo the quota charge too.
 rid:='44444444-4444-4444-8444-444444444444';
 res:=public.reserve_iclub_ai_usage_service_v2(rid,learner,'plus_qa_v2','prepared',fp);
 IF res->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'reservation 2: %',res;END IF;
 res:=public.claim_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'prepared');
 IF res->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'claim 2: %',res;END IF;
 failed:=false;
 BEGIN
   res:=public.finish_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'prepared','completed');
 EXCEPTION WHEN OTHERS THEN
   IF SQLERRM NOT LIKE '%synthetic_delivery_commit_failure%' THEN
     RAISE; END IF;
   failed:=true;
 END;
 IF NOT failed THEN RAISE EXCEPTION 'synthetic failure was not reached';END IF;
 IF NOT EXISTS (SELECT 1 FROM private.iclub_ai_usage_reservations
    WHERE request_id=rid AND status='reserved') OR NOT EXISTS (
    SELECT 1 FROM private.iclub_ai_request_tombstones_v21
    WHERE request_id=rid AND status='claimed') THEN
   RAISE EXCEPTION 'half-committed quota or delivery after injected failure'; END IF;
 SELECT committed_units,reserved_units INTO old_units,old_reserved
 FROM private.iclub_ai_usage_periods WHERE user_id=learner AND status='active';
 IF old_units IS DISTINCT FROM 3 OR old_reserved IS DISTINCT FROM 1 THEN
  RAISE EXCEPTION 'rollback failed: committed % reserved %',old_units,old_reserved;END IF;
 EXECUTE 'DROP TRIGGER synthetic_fail_tombstone_after_quota ON private.iclub_ai_request_tombstones_v21';
 res:=public.finish_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'prepared','completed');
 IF res->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'retry after rollback: %',res;END IF;
 SELECT committed_units,reserved_units INTO old_units,old_reserved
 FROM private.iclub_ai_usage_periods WHERE user_id=learner AND status='active';
 IF old_units IS DISTINCT FROM 4 OR old_reserved IS DISTINCT FROM 0 THEN
  RAISE EXCEPTION 'finalize after successful retry failed';END IF;

 -- A failed preparation should release one reserved unit and commit zero.
 rid:='55555555-5555-4555-8555-555555555555';
 res:=public.reserve_iclub_ai_usage_service_v2(rid,learner,'plus_qa_v2','prepared',fp);
 IF res->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'reserve 3: %',res;END IF;
 res:=public.claim_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'prepared');
 IF res->>'allowed' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'claim 3: %',res;END IF;
 res:=public.finish_iclub_ai_delivery_service_v21(rid,learner,sid,fp,'prepared','released');
 IF res->>'ok' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'release 3: %',res;END IF;
 SELECT committed_units,reserved_units INTO old_units,old_reserved
 FROM private.iclub_ai_usage_periods WHERE user_id=learner AND status='active';
 IF old_units IS DISTINCT FROM 4 OR old_reserved IS DISTINCT FROM 0 THEN
  RAISE EXCEPTION 'released failure charged learner % %',old_units,old_reserved;END IF;
 RAISE NOTICE 'REAL v1/v2 meter + delivery atomic commit, injected rollback and release: GREEN';
END $cases$;
ROLLBACK;
\echo 'Atomic meter/delivery scratch fixture ROLLED BACK; no production data used.'
