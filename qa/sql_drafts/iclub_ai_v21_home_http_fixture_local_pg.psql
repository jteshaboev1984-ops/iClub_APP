-- iClub unified AI §83: self-contained EMPTY PostgreSQL 16 scratch test.
-- Every statement rolled back; no live Supabase connection or data.
\set ON_ERROR_STOP on
BEGIN;
-- Isolated HTTP end-to-end fixture, durable only until scratch DB is dropped.

DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR to_regclass('public.tour_attempts') IS NOT NULL
 THEN RAISE EXCEPTION 'STOP: only virgin scratch database allowed'; END IF;
END $guard$;
DO $roles$
DECLARE r text;
BEGIN
 FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname=r)
  THEN EXECUTE format('CREATE ROLE %I NOLOGIN',r); END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA private;
CREATE TABLE private.iclub_global_ai_runtime_config(
 id int PRIMARY KEY,kill_switch boolean,gateway_enabled boolean);
CREATE TABLE private.exam_qa(user_id uuid PRIMARY KEY,active boolean NOT NULL);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(u uuid)
 RETURNS boolean LANGUAGE sql STABLE SET search_path='' AS
 $$SELECT coalesce((SELECT active FROM private.exam_qa WHERE user_id=u),false)$$;
CREATE TABLE private.iclub_ai_v21_current_screen(
 user_id uuid PRIMARY KEY,current_handle uuid,revision bigint NOT NULL);
CREATE TABLE private.iclub_ai_v21_scoped_contexts(
 context_handle uuid PRIMARY KEY,user_id uuid NOT NULL,context_revision bigint NOT NULL,
 surface_code text,app_view_code text,feature_code text,topic_key text,
 subject_key text,expires_at timestamptz,revoked_at timestamptz);
CREATE FUNCTION public.get_iclub_ai_v21_scoped_context_service(u uuid,h text)
 RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path='' AS $$
 SELECT jsonb_build_object('allowed',exists(
  SELECT 1 FROM private.iclub_ai_v21_current_screen n
  JOIN private.iclub_ai_v21_scoped_contexts c
   ON c.context_handle=n.current_handle AND c.user_id=n.user_id
   AND c.context_revision=n.revision
  WHERE n.user_id=u AND c.context_handle::text=h AND c.surface_code='home'
    AND c.revoked_at IS NULL AND c.expires_at>now()
 ))$$;
CREATE TABLE public.subjects(
 id bigint PRIMARY KEY,subject_key text,is_active boolean);
CREATE TABLE public.user_subjects(
 id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,user_id uuid,subject_id bigint,mode text NOT NULL CHECK(mode IN ('study','competitive')));
CREATE TABLE public.practice_sessions_v4(
 id bigint PRIMARY KEY,user_id uuid,subject_id bigint,status text,
 finalized_at timestamptz,question_ids bigint[]);
CREATE TABLE public.practice_session_answers_v4(
 session_id bigint,question_id bigint,is_correct boolean,answered_at timestamptz);
CREATE TABLE public.tours(
 id bigint PRIMARY KEY,subject_id bigint,end_date date,is_active boolean);
CREATE TABLE public.tour_attempts(
 id bigint PRIMARY KEY,user_id uuid,tour_id bigint,status text);
CREATE TABLE public.tour_session_runtime_v4(
 attempt_id bigint PRIMARY KEY,user_id uuid,tour_id bigint,finalized_at timestamptz);
\ir iclub_ai_v21_home_scan_scratch_UNAPPLIED.sql
INSERT INTO private.iclub_global_ai_runtime_config VALUES(1,false,true);
