-- Standalone synthetic Postgres 16+ proof against REAL iClub table shapes.
-- CI provisions an EMPTY local scratch database; all data rolled back.
\set ON_ERROR_STOP on
BEGIN;
DO $guard$
BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 OR (inet_server_addr() IS NOT NULL
  AND inet_server_addr() NOT IN ('127.0.0.1'::inet,'::1'::inet)
  AND NOT (inet_server_addr() << '172.16.0.0/12'::cidr AND
   current_setting('application_name')='iclub_ai_v21_local_scratch'))
 OR to_regclass('public.tour_attempts') IS NOT NULL THEN
   RAISE EXCEPTION 'STOP: only virgin localhost scratch may run v2.1 real-schema proof';
 END IF;
END $guard$;
DO $roles$
DECLARE role_name text;
BEGIN
 FOREACH role_name IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  IF NOT EXISTS(SELECT FROM pg_roles WHERE rolname=role_name)
  THEN EXECUTE format('CREATE ROLE %I NOLOGIN',role_name); END IF;
 END LOOP;
END $roles$;
CREATE SCHEMA private;
CREATE TABLE private.iclub_global_ai_runtime_config(
 id smallint primary key,kill_switch boolean, gateway_enabled boolean);
CREATE TABLE private.exam_guard_qa(user_id uuid primary key,active boolean not null);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(p_user_id uuid)
RETURNS boolean LANGUAGE sql STABLE SET search_path='' AS
$$SELECT COALESCE((SELECT active FROM private.exam_guard_qa WHERE user_id=p_user_id),false)$$;

-- Columns and relations below were read-only introspected from production
-- 2026-10-14, WITHOUT selecting a single learner record.
CREATE TABLE public.subjects(
 id bigint primary key,subject_key text not null,is_active boolean not null);
CREATE TABLE public.user_subjects(
 id bigint generated always as identity primary key,user_id uuid not null,
 subject_id bigint not null);
CREATE TABLE public.practice_sessions_v4(
 id bigint primary key,user_id uuid not null,subject_id bigint not null,
 status text not null,finalized_at timestamptz,question_ids bigint[] not null,
 legacy_attempt_id bigint);
CREATE TABLE public.practice_session_answers_v4(
 session_id bigint not null,question_id bigint not null,
 user_answer text,is_correct boolean,answered_at timestamptz,
 primary key(session_id,question_id));
CREATE TABLE public.tours(
 id bigint primary key,subject_id bigint not null,tour_no smallint,
 end_date date,is_active boolean);
CREATE TABLE public.tour_attempts(
 id bigint primary key,user_id uuid not null,tour_id bigint not null,
 status text not null,created_at timestamptz default now());
CREATE TABLE public.tour_session_runtime_v4(
 attempt_id bigint primary key,user_id uuid not null,tour_id bigint not null,
 client_session_id text,question_ids bigint[],finalized_at timestamptz);
CREATE TABLE public.tour_answers(
 id bigint primary key,attempt_id bigint not null,question_id bigint not null,
 user_answer text,is_correct boolean);
\ir iclub_ai_v21_real_schema_screen_proof_UNAPPLIED.sql
