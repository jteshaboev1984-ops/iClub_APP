DO $cases$
DECLARE
 learner uuid:='11111111-1111-4111-8111-111111111111';
 foreign_user uuid:='22222222-2222-4222-8222-222222222222';
 x jsonb;
BEGIN
 -- All positive academic evidence MUST fail while global AI is off.
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_session_v4',p_session_id=>900);
 IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'kill switch bypass'; END IF;
 UPDATE private.iclub_global_ai_runtime_config SET kill_switch=false,gateway_enabled=true;
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_session_v4',p_session_id=>900);
 IF x->>'allowed' IS DISTINCT FROM 'true' OR x#>>'{evidence,subject_key}'<>'economics'
 OR x#>>'{evidence,status}'<>'finalized' OR x#>>'{evidence,id}'<>'900' THEN
  RAISE EXCEPTION 'Completed real-schema Practice evidence failed: %',x;END IF;
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_answer_v4',p_session_id=>900,p_question_id=>901);
 IF x->>'allowed' IS DISTINCT FROM 'true' OR x#>>'{evidence,topic_key}'<>'question_901'
 OR (x#>>'{evidence,revision}')::bigint<=0 THEN
  RAISE EXCEPTION 'Exact checked Practice answer proof missing: %',x;END IF;
 IF x::text ~* 'SENSITIVE_ANSWER|user_answer|is_correct|correct_answer|score|percent' THEN
  RAISE EXCEPTION 'Private Practice content leaked: %',x;END IF;
 FOR x IN
 SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_session_v4',p_session_id=>910)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(foreign_user,'practice_session_v4',p_session_id=>900)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_answer_v4',p_session_id=>900,p_question_id=>902)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_answer_v4',p_session_id=>900,p_question_id=>999)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_session_v4',p_session_id=>99)
 LOOP
  IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Unsafe Practice admitted: %',x;END IF;
 END LOOP;
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>100);
 IF x->>'allowed' IS DISTINCT FROM 'true' OR x#>>'{evidence,unlocked}'<>'true'
 OR x#>>'{evidence,topic_key}'<>'tour_30_archive' THEN
   RAISE EXCEPTION 'Opened Tour archive proof failed: %',x;END IF;
 IF x::text ~* 'SENSITIVE_TOUR_ANSWER|user_answer|correct_answer|score' THEN
  RAISE EXCEPTION 'Private Tour content leaked';END IF;
 FOR x IN
 SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>101)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>102)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>103)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>105)
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(foreign_user,'tour_archive_access',p_attempt_id=>100)
 LOOP IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Closed/foreign/unfinalized Tour opened: %',x;END IF; END LOOP;
 -- General Help/Home/Profile/etc cannot be invented from academic rows.
 FOR x IN
 SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'current_screen')
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'home_next_actions')
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'profile_aggregate')
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'navigation',p_view=>'home')
 UNION ALL SELECT public.get_iclub_ai_v21_screen_evidence_service(learner,'lesson',p_lesson_id=>101)
 LOOP IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Unsupported trusted screen invented: %',x;END IF; END LOOP;
 INSERT INTO private.exam_guard_qa VALUES(learner,true);
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>100);
 IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Protected assessment bypass';END IF;
 DELETE FROM private.exam_guard_qa;
 UPDATE public.subjects SET is_active=false WHERE id=10;
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'tour_archive_access',p_attempt_id=>100);
 IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Deactivated subject bypass';END IF;
 UPDATE public.subjects SET is_active=true WHERE id=10;
 DELETE FROM public.user_subjects WHERE user_id=learner AND subject_id=10;
 x:=public.get_iclub_ai_v21_screen_evidence_service(learner,'practice_session_v4',p_session_id=>900);
 IF x->>'allowed' IS DISTINCT FROM 'false' THEN RAISE EXCEPTION 'Removed entitlement bypass';END IF;
 RAISE NOTICE 'Verified real-schema Practice/Tours owner, completion, dates, rights and privacy GREEN';
END $cases$;
DO $privileges$
BEGIN
 IF has_function_privilege('anon',
 'public.get_iclub_ai_v21_screen_evidence_service(uuid,text,text,text,bigint,bigint,bigint,bigint)','EXECUTE')
 OR has_function_privilege('authenticated',
 'public.get_iclub_ai_v21_screen_evidence_service(uuid,text,text,text,bigint,bigint,bigint,bigint)','EXECUTE')
 OR NOT has_function_privilege('service_role',
 'public.get_iclub_ai_v21_screen_evidence_service(uuid,text,text,text,bigint,bigint,bigint,bigint)','EXECUTE')
 THEN RAISE EXCEPTION 'Real-schema proof must be service_role-only';END IF;
END $privileges$;
ROLLBACK;
\echo 'Schema-exact evidence regression fully rolled back, no production SQL applied.'
