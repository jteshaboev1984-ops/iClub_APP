VALUES
(900,'11111111-1111-4111-8111-111111111111',10,1,'synthetic-a',ARRAY[901]::bigint[],'finalized',now(),now()),
(910,'22222222-2222-4222-8222-222222222222',10,1,'synthetic-b',ARRAY[911]::bigint[],'finalized',now(),now());
