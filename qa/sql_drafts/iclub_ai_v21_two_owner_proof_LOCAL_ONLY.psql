-- §117 isolated owner and scope tests; NEVER production JWT emulation.
DO $q$ BEGIN
 IF current_database() !~ '^iclub_ai_v21_scratch_[a-z0-9_]+$'
 THEN RAISE EXCEPTION 'STOP scratch only';END IF;
END $q$;
CREATE SCHEMA auth;
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE
SET search_path='' AS $f$
 SELECT nullif(current_setting('request.jwt.claim.sub',true),'')::uuid
$f$;
GRANT USAGE ON SCHEMA auth TO authenticated;
GRANT EXECUTE ON FUNCTION auth.uid() TO authenticated;
GRANT SELECT ON public.user_subjects,public.tour_attempts TO authenticated;
ALTER TABLE public.user_subjects ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.tour_attempts ENABLE ROW LEVEL SECURITY;
CREATE POLICY qa_subject_owner ON public.user_subjects
 FOR SELECT TO authenticated USING(user_id=auth.uid());
CREATE POLICY qa_tour_owner ON public.tour_attempts
 FOR SELECT TO authenticated USING(user_id=auth.uid());
INSERT INTO public.users(id,first_name,must_change_password,created_at)
VALUES('11111111-1111-4111-8111-111111111111','Synthetic A',false,now()),
('22222222-2222-4222-8222-222222222222','Synthetic B',false,now());
