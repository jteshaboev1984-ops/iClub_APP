VALUES(401,'11111111-1111-4111-8111-111111111111',40,1,25,40,'submitted',now()),
(402,'22222222-2222-4222-8222-222222222222',40,1,25,40,'submitted',now());
INSERT INTO public.tour_session_runtime_v4(attempt_id,user_id,tour_id,client_session_id,question_ids,finalized_at,created_at)
VALUES(401,'11111111-1111-4111-8111-111111111111',40,'synthetic-a',ARRAY[1]::bigint[],now(),now()),
(402,'22222222-2222-4222-8222-222222222222',40,'synthetic-b',ARRAY[2]::bigint[],now(),now());
SET request.jwt.claim.sub='11111111-1111-4111-8111-111111111111';
SET ROLE authenticated;
DO $verify_a$ BEGIN
 IF (SELECT count(*) FROM public.user_subjects)<>1
 OR (SELECT count(*) FROM public.tour_attempts)<>1
 OR EXISTS(SELECT 1 FROM public.tour_attempts
 WHERE user_id='22222222-2222-4222-8222-222222222222')
 THEN RAISE EXCEPTION 'RLS A saw B';END IF;
END $verify_a$;
RESET ROLE;
SET request.jwt.claim.sub='22222222-2222-4222-8222-222222222222';
SET ROLE authenticated;
DO $verify_b$ BEGIN
 IF (SELECT count(*) FROM public.user_subjects)<>1
 OR (SELECT count(*) FROM public.tour_attempts)<>1
 OR EXISTS(SELECT 1 FROM public.user_subjects
 WHERE user_id='11111111-1111-4111-8111-111111111111')
 THEN RAISE EXCEPTION 'RLS B saw A';END IF;
END $verify_b$;
RESET ROLE;
RESET request.jwt.claim.sub;
DO $rls$ BEGIN
 IF has_function_privilege('authenticated','public.mint_iclub_ai_v21_practice_context_service(uuid,bigint,bigint)','EXECUTE')
 THEN RAISE EXCEPTION 'Client has privileged RPC';END IF;
 RAISE NOTICE 'TWO_OWNER_RLS_GREEN: two isolated synthetic owners';
END $rls$;
CREATE TABLE private.qa_protected_exam(user_id uuid PRIMARY KEY,active boolean NOT NULL);
INSERT INTO private.qa_protected_exam VALUES
('11111111-1111-4111-8111-111111111111',false),
('22222222-2222-4222-8222-222222222222',false);
CREATE OR REPLACE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(p_user_id uuid)
RETURNS boolean LANGUAGE sql STABLE SET search_path='' AS $f$
 SELECT coalesce((SELECT active FROM private.qa_protected_exam
 WHERE user_id=p_user_id),true)
$f$;
DO $off$ BEGIN
 IF (public.mint_iclub_ai_v21_practice_context_service(
 '11111111-1111-4111-8111-111111111111',900,901)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'OFF minted practice context';END IF;
END $off$;
-- Synthetic global toggle inside a transaction; NEVER production.
UPDATE private.iclub_global_ai_runtime_config
SET kill_switch=false,ui_enabled=true,gateway_enabled=true WHERE id=1;
DO $scope$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 hA text;hB text; j jsonb;
 n bigint;
BEGIN
 SELECT count(*) INTO n FROM public.practice_session_answers_v4;
 j:=public.mint_iclub_ai_v21_practice_context_service(a,900,901);
 IF j->>'allowed'<>'true' THEN RAISE EXCEPTION 'A own Practice denied %',j;END IF;
 hA:=j->>'context_handle';
 j:=public.get_iclub_ai_v21_screen_evidence_service(
  a,'practice_answer_v4',NULL,NULL,NULL,900,901,NULL);
 IF j->>'allowed'<>'true' THEN RAISE EXCEPTION 'A evidence denied: %',j;END IF;
 j:=public.get_iclub_ai_v21_screen_evidence_service(
  b,'practice_answer_v4',NULL,NULL,NULL,900,901,NULL);
 IF j->>'allowed'<>'false' THEN RAISE EXCEPTION 'B read A evidence';END IF;
 IF (public.get_iclub_ai_v21_scoped_context_service(a,hA)->>'allowed')<>'true'
 THEN RAISE EXCEPTION 'A own context denied';END IF;
 IF (public.get_iclub_ai_v21_scoped_context_service(b,hA)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'B reused A handle';END IF;
 IF (public.mint_iclub_ai_v21_practice_context_service(b,900,901)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'B minted A attempt';END IF;
 j:=public.mint_iclub_ai_v21_practice_context_service(b,910,911);
 IF j->>'allowed'<>'true' THEN RAISE EXCEPTION 'B own Practice denied %',j;END IF;
 hB:=j->>'context_handle';
 IF (public.get_iclub_ai_v21_scoped_context_service(b,hB)->>'allowed')<>'true'
 THEN RAISE EXCEPTION 'B handle denied';END IF;
 UPDATE public.practice_sessions_v4 SET status='in_progress' WHERE id=900;
 IF (public.get_iclub_ai_v21_scoped_context_service(a,hA)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'Academic status revocation bypass';END IF;
 IF (public.get_iclub_ai_v21_screen_evidence_service(a,'practice_answer_v4',NULL,NULL,NULL,900,901,NULL)->>'allowed')<>'false' THEN RAISE EXCEPTION 'Evidence stale finalization';END IF;
 UPDATE public.practice_sessions_v4 SET status='finalized' WHERE id=900;
 UPDATE private.qa_protected_exam SET active=true WHERE user_id=a;
 IF (public.get_iclub_ai_v21_scoped_context_service(a,hA)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'Protected assessment bypass';END IF;
 UPDATE private.qa_protected_exam SET active=false WHERE user_id=a;
 DELETE FROM public.user_subjects WHERE user_id=a;
 IF (public.get_iclub_ai_v21_scoped_context_service(a,hA)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'Enrollment revoked but context live';END IF;
 IF (public.get_iclub_ai_v21_scoped_context_service(b,hB)->>'allowed')<>'true'
 THEN RAISE EXCEPTION 'B affected by A revocation';END IF;
 j:=public.revoke_iclub_ai_v21_scoped_context_service(b,hB);
 IF j->>'ok'<>'true' THEN RAISE EXCEPTION 'Revoke failed';END IF;
 IF (public.get_iclub_ai_v21_scoped_context_service(b,hB)->>'allowed')<>'false'
 THEN RAISE EXCEPTION 'Revoked bearer still valid';END IF;
 BEGIN
  INSERT INTO public.practice_session_answers_v4(
   session_id,question_id,is_correct,time_spent,answered_at)
  VALUES(900,901,false,1,now());
  RAISE EXCEPTION 'Duplicate academic record permitted';
 EXCEPTION WHEN unique_violation THEN
  NULL;
 END;
 IF (SELECT count(*) FROM public.practice_session_answers_v4)<>n
 THEN RAISE EXCEPTION 'Academic data corrupted after failed write';END IF;
 RAISE NOTICE 'TWO_OWNER_SCOPE_GREEN: A/B, after-change authorization, atomic error';
END $scope$;
UPDATE private.iclub_global_ai_runtime_config
 SET kill_switch=true,ui_enabled=false,gateway_enabled=false WHERE id=1;
