VALUES(900,901,'Synthetic A',false,5,now()),(910,911,'Synthetic B',false,5,now());
INSERT INTO public.tours(id,subject_id,tour_no,season_id,end_date,is_active,created_at)
VALUES(40,10,1,1,(now() AT TIME ZONE 'Asia/Tashkent')::date-1,false,now());
