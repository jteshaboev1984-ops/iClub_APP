\set ON_ERROR_STOP on
DO $roles$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN CREATE ROLE service_role NOLOGIN; END IF;
END $roles$;
CREATE SCHEMA private;
CREATE TABLE private.iclub_ai_v21_beta_control(
 singleton smallint PRIMARY KEY,beta_enabled boolean,prepared_enabled boolean,
 generation_enabled boolean,approved_release text DEFAULT 'owner_beta_v21');
INSERT INTO private.iclub_ai_v21_beta_control VALUES(1,true,true,false);
CREATE TABLE private.iclub_ai_v21_academic_policy(
 singleton smallint PRIMARY KEY,enabled boolean,provider_enabled boolean);
INSERT INTO private.iclub_ai_v21_academic_policy VALUES(1,true,false);
CREATE TABLE private.iclub_ai_v21_beta_members(
 user_id uuid PRIMARY KEY,enabled boolean,consent_at timestamptz,consent_version text);
INSERT INTO private.iclub_ai_v21_beta_members VALUES
 ('11111111-1111-4111-8111-111111111111',true,now(),'global_ai_beta_v21'),
 ('22222222-2222-4222-8222-222222222222',true,now(),'global_ai_beta_v21'),
 ('33333333-3333-4333-8333-333333333333',true,NULL,NULL);

CREATE TABLE private.iclub_ai_v21_beta_usage(
 user_id uuid PRIMARY KEY,started_at timestamptz NOT NULL,
 committed_count smallint NOT NULL,updated_at timestamptz DEFAULT now());
CREATE TABLE private.iclub_ai_v21_beta_deliveries(
 request_id uuid PRIMARY KEY,user_id uuid NOT NULL);
CREATE TABLE public.practice_sessions_v4(user_id uuid,status text);
CREATE FUNCTION private.iclub_ai_has_active_protected_assessment_v1(p_uid uuid)
RETURNS boolean LANGUAGE sql STABLE SET search_path=''
AS $stub$ SELECT false $stub$;

CREATE SCHEMA extensions;
CREATE EXTENSION pgcrypto WITH SCHEMA extensions;
CREATE TABLE private.iclub_ai_v21_beta_help_sources(
 help_key text NOT NULL,locale text NOT NULL,
 message text NOT NULL,source_version text NOT NULL,
 publication_revision bigint NOT NULL,
 source_hash text NOT NULL,content_reviewed boolean NOT NULL,
 rights_reviewed boolean NOT NULL,locale_reviewed boolean NOT NULL,
 published boolean NOT NULL,revoked boolean NOT NULL,
 approved_at timestamptz NOT NULL,
 PRIMARY KEY(help_key,locale)
);
INSERT INTO private.iclub_ai_v21_beta_help_sources
(help_key,locale,message,source_version,publication_revision,source_hash,
 content_reviewed,rights_reviewed,locale_reviewed,published,revoked,approved_at)
SELECT 'synthetic_help_'||s.i,s.loc,
 repeat('Synthetic source for General Help in iClub with navigation instructions. ',2),
 CASE WHEN s.i<=7 THEN 'synthetic_guidance_v1' ELSE 'synthetic_nav_v1' END,
 1,
 encode(extensions.digest(convert_to(repeat(
 'Synthetic source for General Help in iClub with navigation instructions. ',2),
 'UTF8'),'sha256'),'hex'),
 true,true,true,true,false,now()
FROM (SELECT i,loc FROM generate_series(1,13) AS i
 CROSS JOIN (VALUES('en'),('ru'),('uz')) AS l(loc)) AS s;
